# Copy these names into GitHub → Settings → Secrets and variables → Actions → Variables.
# Missing or false = off. Values other than true/false/yes/no/on/off/1/0 fail the run,
# even when the master switch is off.
# Listing, What's New, screenshots, creative assets and review need the tag's App Store
# version to exist: turn on IOS_CREATE_VERSION or create it in App Store Connect first.
# A read-only preflight checks it before anything is built.

# --- iOS (v<MARKETING_VERSION> tags; .github/workflows/ios-release.yml) ---
# Master switch: when off, no iOS store operation runs (the tag still gets a GitHub Release).
IOS_RELEASE_AUTOMATION=false
# Create the tag's App Store version in App Store Connect when it is missing (tag runs
# only, before the preflight). Leaves an existing version alone; refuses when another
# version is still on its way to the store or the tag is not newer than every existing
# version.
IOS_CREATE_VERSION=false
# Build, sign and upload the binary to App Store Connect, then wait until it is processed.
IOS_UPLOAD_BUILD=false
# Description, keywords, promotional text, marketing/support URLs, and App Info
# (name, subtitle, privacy policy URL) from store/metadata/ios/<locale>/.
IOS_UPLOAD_LISTING=false
# What's New from store/metadata/ios/<locale>/whats_new.txt.
IOS_UPLOAD_WHATS_NEW=false
# iPhone 6.9" + iPad 13" screenshots from store/metadata/screenshots/ios/{iphone,ipad}/,
# plus iPhone Duo (iphone-duo/) and Apple Watch (watch/) sets when those folders hold
# PNGs. Uploaded as RGB copies (no alpha channel); the committed files are only read.
IOS_UPLOAD_SCREENSHOTS=false
# Product page header and search results images from store/creative/ios. Each new
# image is uploaded to the Asset Library once and sent to App Review in a submission
# of its own (never the version's); once Apple approves it, a run places it on the
# version while the version can be edited. Empty folders mean nothing to do.
IOS_UPLOAD_CREATIVE_ASSETS=false
# Select this run's processed build and submit the version (and Ready-to-Submit
# catalog products) for App Review. Needs IOS_UPLOAD_BUILD.
IOS_SUBMIT_REVIEW=false
# true = release automatically after approval; false = you release it by hand.
# Needs IOS_SUBMIT_REVIEW.
IOS_PUBLIC_RELEASE=false
# Build readiness polling (defaults shown): poll interval 10–600 s; total wait
# 10–300 min counted from upload start (upload + App Store Connect processing).
IOS_BUILD_POLL_SECONDS=30
IOS_BUILD_WAIT_MINUTES=120
