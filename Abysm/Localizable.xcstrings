    "creature.giantsquid.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real sea monster — rarely seen alive, it can grow as long as a school bus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un verdadero monstruo marino, rara vez visto vivo; puede ser tan largo como un autobús escolar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vrai monstre marin — rarement vu vivant, il peut atteindre la longueur d'un bus scolaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein echtes Seeungeheuer — lebend kaum gesehen, kann er so lang wie ein Schulbus werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vero mostro marino, raro da vedere vivo, può diventare lungo come uno scuolabus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um verdadeiro monstro marinho — raramente visto vivo, pode chegar ao tamanho de um ônibus escolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящее морское чудище — редко видимое живым, вырастает с длину школьного автобуса."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawdziwy potwór morski — rzadko widywany żywcem, bywa długi jak szkolny autobus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een echt zeemonster — zelden levend gezien, hij kan zo lang worden als een schoolbus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek bir deniz canavarı; canlı pek görülmez, bir okul otobüsü kadar uzayabilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक असली समुद्री दानव — जीवित विरले ही दिखता है, स्कूल बस जितना लंबा बढ़ सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本物の海の怪物。生きた姿は稀で、スクールバスほど長く育つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진짜 바다 괴물 — 살아있는 모습은 보기 드물고, 통학버스만큼 길게 자란다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真正的海怪——极少有人见其活体，身长可达一辆校车那么长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真正的海怪——極少見到活體，能長得像校車那麼長。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وحش بحر حقيقي، نادرًا ما يُرى حيًّا، وقد يطول كحافلة مدرسية."
          }
        }
      }
    },
    "creature.squidworm.name": {
