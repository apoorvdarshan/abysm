    "paywall.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dive past 1,000 m to the trench floor — the deep zones, ~45 more creatures, and landmarks like the Titanic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desciende más allá de los 1,000 m hasta el fondo de la fosa: las zonas abisales, ~45 criaturas más y enclaves como el Titanic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plongez au-delà de 1,000 m jusqu'au fond de la fosse — les zones abyssales, ~45 créatures de plus et des sites comme le Titanic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauche unter 1.000 m bis zum Grund des Tiefseegrabens — die tiefen Zonen, ~45 weitere Kreaturen und Wahrzeichen wie die Titanic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi oltre i 1.000 m fino al fondo della fossa: le zone profonde, circa 45 nuove creature e relitti come il Titanic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergulhe além dos 1.000 m até o fundo da fossa — as zonas profundas, ~45 novas criaturas e marcos como o Titanic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погрузитесь глубже 1,000 m — ко дну впадины: тёмные зоны, ещё ~45 существ и ориентиры вроде «Титаника»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanurkuj poniżej 1000 m aż na dno rowu — głębinowe strefy, ~45 nowych stworzeń i obiekty takie jak Titanic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duik voorbij 1.000 m naar de bodem van de trog — de diepzeezones, ~45 extra wezens en oriëntatiepunten zoals de Titanic."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.000 m'nin ötesine, çukurun dibine dal — derin bölgeler, ~45 yeni canlı ve Titanic gibi simgesel kalıntılar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000 m से नीचे खाई की तलहटी तक उतरें — गहरे क्षेत्र, ~45 और जीव, और टाइटैनिक जैसी निशानियाँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000 mを越えて海溝の底へ。深層エリア、新たに~45種の生き物、そしてタイタニック号などの名所が待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000 m 아래 해구 바닥까지 잠수하세요 — 심해 구역, 45종에 가까운 생물, 그리고 타이타닉 같은 명소들이 기다립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "潜入 1,000 m 以下直达海沟底部——探索深海区域、约 45 种新生物，以及泰坦尼克号等沉没地标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "潛入 1,000 m 以下直抵海溝底部——探索深海區域、約 45 種新生物，以及鐵達尼號等地標。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اغطس إلى ما دون 1,000 m حتى قاع الخندق — المناطق العميقة، و~45 مخلوقًا إضافيًا، ومعالم مثل تيتانيك."
          }
        }
      }
    },
