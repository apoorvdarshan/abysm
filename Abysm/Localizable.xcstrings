    "creature.wolfeel.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Despite the name it's a fish, with strong jaws for crushing shellfish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pese al nombre es un pez, con mandíbulas fuertes para triturar mariscos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malgré son nom, c'est un poisson, aux mâchoires puissantes pour broyer les coquillages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotz des Namens ein Fisch, mit starken Kiefern zum Zerknacken von Schalentieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonostante il nome è un pesce, con mascelle forti per frantumare i crostacei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apesar do nome é um peixe, com mandíbulas fortes para esmagar mariscos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несмотря на имя, это рыба с крепкими челюстями, дробящими моллюсков."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimo nazwy to ryba, z mocnymi szczękami do kruszenia skorupiaków."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondanks de naam een vis, met sterke kaken om schelpdieren te kraken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adına rağmen bir balıktır; kabukluları ezen güçlü çenelere sahiptir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम के बावजूद यह एक मछली है, जिसके जबड़े शंख-सीप कुचलने में मज़बूत हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に反して魚で、貝を砕く強いあごを持つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 달리 물고기이며, 조개를 으깨는 강한 턱을 지녔다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽管名字带“鳗”，它其实是鱼，长着能咬碎贝类的强健颌部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雖名為鰻，其實是魚，有能咬碎貝類的強健顎部。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رغم اسمه فهو سمكة، بفكّين قويين لسحق المحاريات."
          }
        }
      }
    },
