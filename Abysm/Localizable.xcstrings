    "creature.frilledshark.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An eel-like 'living fossil' shark with 300 needle-like teeth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un \"fósil viviente\" con forma de anguila y 300 dientes como agujas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Fossile vivant » au corps d'anguille, aux 300 dents en aiguilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aalartiges „lebendes Fossil“ mit 300 nadelspitzen Zähnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 'fossile vivente' simile a un'anguilla con 300 denti ad ago."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 'fóssil vivo' parecido com enguia, com 300 dentes feito agulhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угреобразное «живое ископаемое» с 300 игольчатыми зубами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Węgorzowata „żywa skamieniałość” z 300 igłowatymi zębami."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aalachtige 'levend fossiel'-haai met 300 naaldscherpe tanden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "300 iğne gibi dişli, yılanbalığını andıran 'yaşayan fosil' bir köpekbalığıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "300 सुई-से दाँतों वाली एक बाम-नुमा 'जीवित जीवाश्म' शार्क।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウナギのような姿の「生きた化石」のサメ。針状の歯を300本持つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바늘 같은 이빨 300개를 지닌 장어 모양의 '살아있는 화석' 상어."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形似鳗鱼的“活化石”鲨鱼，长着300颗针状的牙齿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "形似鰻的「活化石」鯊魚，有 300 顆針狀牙齒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرش \"أحفورة حية\" يشبه الأنقليس وله 300 سنّ كالإبر."
          }
        }
      }
    },
    "creature.goblinshark.name": {
