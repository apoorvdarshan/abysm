    "creature.greatwhite.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Senses a single drop of blood from far away using electroreception."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta una sola gota de sangre a lo lejos gracias a la electrorrecepción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il détecte une seule goutte de sang de très loin grâce à l'électroréception."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spürt mittels Elektrorezeption einen einzigen Blutstropfen aus weiter Ferne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percepisce da lontano una sola goccia di sangue grazie all'elettrorecezione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente uma única gota de sangue de longe usando eletrorrecepção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чует каплю крови издалека благодаря электрорецепции."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczuwa pojedynczą kroplę krwi z daleka dzięki elektrorecepcji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bespeurt een enkele druppel bloed van verre via elektroreceptie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektroresepsiyon kullanarak uzaktaki tek bir damla kanı algılar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विद्युत-संवेदन से दूर से ही खून की एक बूँद को भाँप लेती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電気を感知し、遠くの血の一滴さえ察知する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전기수용 능력으로 멀리서도 피 한 방울을 감지한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借助电感应，能在远处觉察到一滴血。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藉電覺能感知遠處的一滴血。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستشعر قطرة دمٍ واحدة من بعيد عبر الاستقبال الكهربائي."
          }
        }
      }
    },
