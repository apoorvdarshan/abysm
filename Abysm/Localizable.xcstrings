    "creature.blueshark.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slim, ocean-roaming shark that migrates across entire oceans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tiburón esbelto y errante que migra a través de océanos enteros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requin élancé et vagabond qui migre à travers des océans entiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schlanker, hochseewandernder Hai, der ganze Ozeane durchquert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno squalo slanciato e migratore che attraversa interi oceani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tubarão esguio e errante que migra através de oceanos inteiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стройная странствующая акула, что мигрирует через целые океаны."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Smukły, wędrujący rekin, który migruje przez całe oceany."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een slanke, rondzwervende haai die hele oceanen oversteekt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm okyanusları kat ederek göç eden ince, gezgin bir köpekbalığıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पतली, महासागर-भ्रमणकारी शार्क जो पूरे महासागरों को पार करती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細身で外洋を巡る回遊性のサメ。大洋を横断して移動する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대양을 떠도는 날렵한 상어로, 대양 전체를 가로질러 이동한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体形修长、漫游远洋的鲨鱼，能横跨整片海洋迁徙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身形修長、漫遊大洋的鯊魚，會橫越整片海洋遷徙。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرش نحيل جوّاب للمحيطات يهاجر عبرها بأكملها."
          }
        }
      }
    },
