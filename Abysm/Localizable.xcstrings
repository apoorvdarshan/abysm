    "creature.seaangel.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tiny shell-less sea snail that 'flies' on wing-like feet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un diminuto caracol marino sin concha que \"vuela\" con pies en forma de alas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuscule escargot marin sans coquille qui « vole » sur des pieds en forme d'ailes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine winzige schalenlose Meeresschnecke, die auf flügelartigen Füßen „fliegt“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una minuscola lumaca marina senza guscio che 'vola' su piedi simili ad ali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minúsculo caracol marinho sem concha que 'voa' com pés em forma de asas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крошечная морская улитка без раковины, что «летает» на крыльях-ножках."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maleńki ślimak morski bez muszli, który „lata” na skrzydlatych stopach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een piepkleine zeeslak zonder schelp die 'vliegt' op vleugelachtige voetjes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanat benzeri ayaklarla 'uçan', kabuksuz minik bir deniz salyangozudur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नन्ही बिना-खोल वाली समुद्री घोंघी जो पंख-नुमा पैरों पर 'उड़ती' है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "殻を持たない小さな巻貝。翼のような足で「飛ぶ」ように泳ぐ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "껍데기 없는 작은 바다 달팽이로, 날개 같은 발로 '날아' 다닌다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种没有外壳的微小海蜗牛，靠翼状的“足”在水中“飞行”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一種無殼的小海螺，靠翼狀的足「飛行」。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلزون بحري ضئيل بلا صدفة \"يطير\" على قدمين كالجناحين."
          }
        }
      }
    },
    "creature.lanternfish.name": {
