    "creature.bluetang.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bright reef fish with a scalpel-sharp spine near its tail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vistoso pez de arrecife con una espina afilada como un bisturí junto a la cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poisson de récif éclatant doté d'une épine tranchante comme un scalpel près de la queue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leuchtender Riff-Fisch mit einem skalpellscharfen Stachel nahe dem Schwanz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vivace pesce di barriera con una spina affilata come un bisturi vicino alla coda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peixe vivo de recife com um espinho afiado como bisturi perto da cauda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яркая рифовая рыба с острым, как скальпель, шипом у хвоста."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaskrawa ryba rafowa z ostrym jak skalpel kolcem przy ogonie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een felgekleurde rifvis met een vlijmscherpe stekel bij de staart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruğu yakınında neşter gibi keskin dikeni olan parlak bir resif balığı."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक चमकीली भित्ति-मछली जिसकी पूँछ के पास छुरी-सा तेज़ काँटा होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鮮やかなサンゴ礁の魚。尾の近くにカミソリのように鋭いトゲを持つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꼬리 근처에 메스처럼 날카로운 가시를 지닌 밝은 산호초 물고기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色彩鲜艳的珊瑚礁鱼，尾部附近长有刀刃般锋利的硬棘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色彩鮮豔的礁石魚，尾部附近有手術刀般銳利的硬棘。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمكة شعاب زاهية لها شوكة حادة كالمشرط قرب ذيلها."
          }
        }
      }
    },
