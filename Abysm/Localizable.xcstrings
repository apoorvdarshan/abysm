    "creature.fangtooth.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has the largest teeth, for its body size, of any fish in the ocean."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene los dientes más grandes, en proporción al cuerpo, de todos los peces del océano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a les plus grandes dents, par rapport à sa taille, de tous les poissons de l'océan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat, gemessen an der Körpergröße, die größten Zähne aller Fische im Meer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha i denti più grandi, in rapporto al corpo, di qualunque pesce dell'oceano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem os maiores dentes, em relação ao corpo, de qualquer peixe do oceano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У неё самые большие зубы относительно размеров тела среди всех рыб океана."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma największe zęby w stosunku do rozmiaru ciała ze wszystkich ryb w oceanie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft, naar verhouding tot zijn lijf, de grootste tanden van elke vis in de oceaan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut büyüklüğüne oranla okyanustaki tüm balıkların en büyük dişlerine sahiptir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शरीर के अनुपात में समुद्र की किसी भी मछली से बड़े दाँत रखती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体の大きさに対して、海のどの魚よりも大きな歯を持つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸 크기에 비해 바다의 어떤 물고기보다 큰 이빨을 지녔다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按体型比例算，它拥有海洋中所有鱼类里最大的牙齿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以身體比例而言，擁有海中所有魚類最大的牙齒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لها أكبر أسنان نسبةً إلى حجم جسمها بين كل أسماك المحيط."
          }
        }
      }
    },
    "creature.tripodfish.name": {
