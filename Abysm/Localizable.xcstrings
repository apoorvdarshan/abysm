    "zone.sunlight.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, sunlit waters where most ocean life thrives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguas cálidas y soleadas donde prospera la mayor parte de la vida marina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eaux chaudes et ensoleillées où foisonne la vie marine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmes, sonnendurchflutetes Wasser, in dem das meiste Meeresleben gedeiht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acque calde e illuminate dove prospera quasi tutta la vita marina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Águas quentes e ensolaradas onde prospera a maior parte da vida marinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёплые солнечные воды, где обитает большинство морских видов."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciepłe, nasłonecznione wody, gdzie tętni morskie życie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, zonovergoten water waar het meeste zeeleven gedijt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deniz yaşamının çoğunun geliştiği ılık, güneşli sular."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्म, धूप से भरा पानी जहाँ अधिकांश समुद्री जीवन पनपता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "陽光に満ちた暖かい海。多くの海洋生物が暮らす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻하고 햇살 가득한 바다, 대부분의 해양 생물이 번성하는 곳."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温暖的阳光照射的水域，绝大多数海洋生物在此繁衍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫暖灑滿陽光的水域，孕育著大多數海洋生命。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مياه دافئة تغمرها الشمس، حيث تزدهر معظم حياة المحيط."
          }
        }
      }
    },
    "zone.twilight.name": {
