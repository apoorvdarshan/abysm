    "creature.swordfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heats its eyes and brain so it can hunt fast in cold deep water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calienta sus ojos y cerebro para cazar rápido en aguas frías y profundas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il réchauffe ses yeux et son cerveau pour chasser vite dans l'eau froide des profondeurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwärmt Augen und Gehirn, um im kalten Tiefenwasser schnell jagen zu können."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscalda occhi e cervello per cacciare veloce nelle fredde acque profonde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquece os olhos e o cérebro para caçar rápido na água fria das profundezas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Греет глаза и мозг, чтобы стремительно охотиться в холодной глубине."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozgrzewa oczy i mózg, by szybko polować w zimnej głębinie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwarmt zijn ogen en brein om snel te jagen in koud diep water."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soğuk derin suda hızlı avlanabilmek için gözlerini ve beynini ısıtır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी आँखें और दिमाग गर्म रखती है ताकि ठंडे गहरे पानी में तेज़ शिकार कर सके।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目と脳を温め、冷たい深海でも素早く狩りができる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈과 뇌를 데워, 차가운 심해에서도 빠르게 사냥한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能给眼睛和大脑加温，以便在寒冷深水中快速捕猎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能加熱眼睛與腦部，以便在寒冷深水中快速狩獵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدفّئ عينيها ودماغها لتصطاد بسرعة في الأعماق الباردة."
          }
        }
      }
    },
    "creature.nautilus.name": {
