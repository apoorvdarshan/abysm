    "creature.turtle.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds its breath for hours and navigates whole oceans back to its birth beach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguanta la respiración horas y cruza océanos enteros para volver a su playa natal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle retient son souffle des heures et traverse les océans pour revenir à sa plage natale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Atem stundenlang und navigiert über ganze Ozeane zu ihrem Geburtsstrand zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trattiene il respiro per ore e attraversa interi oceani per tornare alla spiaggia natale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prende a respiração por horas e cruza oceanos de volta à praia onde nasceu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задерживает дыхание на часы и через целые океаны возвращается на родной пляж."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje oddech na całe godziny i przemierza oceany, wracając na plażę narodzin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt urenlang de adem in en navigeert hele oceanen terug naar zijn geboortestrand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatlerce nefesini tutar ve doğduğu kumsala dönmek için tüm okyanusları kat ederek yol bulur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घंटों साँस रोके रहता है और पूरे महासागर पार कर अपने जन्म-तट लौट आता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何時間も息を止め、大洋を渡って生まれた浜へ帰る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 시간씩 숨을 참고, 대양을 가로질러 태어난 해변으로 돌아온다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可屏息数小时，能横跨整片海洋洄游回出生的海滩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能憋氣數小時，橫越整片海洋洄游回出生的海灘。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكتم أنفاسها ساعات وتعبر محيطات بأكملها عائدةً إلى شاطئ مولدها."
          }
        }
      }
    },
