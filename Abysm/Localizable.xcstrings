    "creature.cookiecutter.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bites round plugs of flesh from whales, sharks, even submarines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranca bocados redondos de ballenas, tiburones e incluso submarinos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il arrache des bouchées rondes de chair aux baleines, requins, et même aux sous-marins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beißt runde Fleischstücke aus Walen, Haien, sogar U-Booten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strappa tappi rotondi di carne a balene, squali e perfino sommergibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranca pedaços redondos de carne de baleias, tubarões e até submarinos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вырезает круглые куски плоти у китов, акул и даже подлодок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygryza okrągłe kęsy ciała z wielorybów, rekinów, a nawet łodzi podwodnych."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijt ronde plukken vlees uit walvissen, haaien, zelfs onderzeeërs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balinalardan, köpekbalıklarından, hatta denizaltılardan yuvarlak et parçaları ısırır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हेल, शार्क, यहाँ तक कि पनडुब्बियों से माँस के गोल टुकड़े काट लेती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クジラやサメ、潜水艦からさえ、丸く肉をえぐり取る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고래, 상어, 심지어 잠수함에서도 둥근 살점을 도려낸다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从鲸鱼、鲨鱼乃至潜艇身上咬下圆形的肉块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鯨魚、鯊魚甚至潛艇上咬下圓形的肉塊。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقتطع قطعًا مستديرة من لحم الحيتان والقروش، بل وحتى الغوّاصات."
          }
        }
      }
    },
    "creature.dumbooctopus.name": {
