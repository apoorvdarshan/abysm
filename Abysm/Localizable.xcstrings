    "creature.leatherback.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The largest turtle; it dives past 1,200 m chasing jellyfish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tortuga más grande; bucea más allá de 1.200 m persiguiendo medusas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plus grande tortue ; elle plonge au-delà de 1 200 m à la poursuite des méduses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die größte Schildkröte; sie taucht auf der Jagd nach Quallen über 1.200 m tief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tartaruga più grande; si immerge oltre 1.200 m inseguendo le meduse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior tartaruga; mergulha além de 1.200 m perseguindo águas-vivas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупнейшая черепаха; ныряет глубже 1200 м в погоне за медузами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największy żółw; nurkuje poniżej 1200 m w pościgu za meduzami."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grootste schildpad; hij duikt voorbij 1.200 m achter kwallen aan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En büyük kaplumbağadır; denizanası peşinde 1.200 m'nin ötesine dalar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे बड़ा कछुआ; जेलीफ़िश का पीछा करते हुए 1,200 मी से गहरा गोता लगाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大のウミガメ。クラゲを追って1,200m超まで潜る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 거북. 해파리를 쫓아 1,200 m 넘게 잠수한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大的海龟；追逐水母时能潜过1200米。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大的海龜；為追逐水母可潛超過 1,200 m。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكبر السلاحف؛ تغوص لما يتجاوز 1,200 م مطاردةً قناديل البحر."
          }
        }
      }
    },
