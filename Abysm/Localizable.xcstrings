          "stringUnit": {
            "state": "translated",
            "value": "Липарис на 8336 м — близко к пределу, где жизнь ещё возможна."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dennik na 8336 m — blisko granicy, na jakiej życie może przetrwać."
          }
        },
        "nl": {
          "stringUnit": {
