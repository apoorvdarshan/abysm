    "creature.atollajelly.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets off a spinning blue 'burglar alarm' to summon bigger predators onto its attacker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza una \"alarma antirrobo\" azul y giratoria para que depredadores mayores ataquen a su agresor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle déclenche une « alarme » bleue tournoyante pour attirer de plus gros prédateurs sur son agresseur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löst einen kreisenden blauen „Alarm“ aus, um größere Räuber gegen ihren Angreifer zu rufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancia un 'allarme antifurto' blu rotante per attirare predatori più grandi sull'aggressore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispara um 'alarme de assalto' azul giratório para atrair predadores maiores sobre seu agressor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает крутящуюся синюю «сигнализацию», призывая крупных хищников на своего обидчика."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącza wirujący niebieski „alarm antywłamaniowy”, by sprowadzić większe drapieżniki na napastnika."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een ronddraaiend blauw 'inbraakalarm' aan om grotere roofdieren op zijn aanvaller af te roepen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldırganının üzerine daha büyük avcıları çağıran dönen mavi bir 'hırsız alarmı' çalıştırır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घूमती नीली 'चोर-घंटी' बजाकर हमलावर पर बड़े शिकारियों को बुला लेती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青く回る「防犯ベル」を光らせ、より大きな捕食者を襲撃者へ呼び寄せる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸른 빛이 도는 '도난 경보'를 돌려, 공격자에게 더 큰 포식자를 부른다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会触发旋转的蓝色“警报”，召来更大的掠食者对付袭击它的敌人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發出旋轉的藍色「防盜警報」，引來更大的掠食者對付攻擊牠的對象。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلق \"إنذار سرقة\" أزرق دوّارًا ليستدعي مفترسات أكبر على مهاجمه."
          }
        }
      }
    },
