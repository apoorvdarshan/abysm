    "creature.seadragon.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A relative of the seahorse, camouflaged as drifting seaweed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pariente del caballito de mar, camuflado como un alga a la deriva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cousin de l'hippocampe, camouflé en algue à la dérive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Verwandter des Seepferdchens, getarnt als treibender Seetang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parente del cavalluccio marino, mimetizzato come un'alga alla deriva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parente do cavalo-marinho, camuflado como uma alga à deriva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Родич морского конька, замаскированный под плывущие водоросли."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krewny konika morskiego, zamaskowany jak dryfujące wodorosty."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verwant van het zeepaardje, gecamoufleerd als drijvend zeewier."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denizatının akrabasıdır; sürüklenen yosun gibi kamufle olur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समुद्री घोड़े का रिश्तेदार, बहती समुद्री घास के रूप में छिपा रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タツノオトシゴの仲間。漂う海藻に擬態する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해마의 친척으로, 떠다니는 해초처럼 위장한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海马的亲戚，伪装成漂动的海藻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海馬的近親，偽裝成隨波漂流的海藻。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قريب لفرس البحر، يتنكّر كأعشاب بحرية طافية."
          }
        }
      }
    },
