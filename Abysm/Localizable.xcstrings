    "creature.hatchetfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glows on its belly to erase its own silhouette from below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brilla en el vientre para borrar su propia silueta vista desde abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il luit sur son ventre pour effacer sa silhouette vue d'en dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtet am Bauch, um die eigene Silhouette von unten auszulöschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brilla sul ventre per cancellare la propria sagoma vista dal basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brilha na barriga para apagar a própria silhueta vista de baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светится брюхом, чтобы стереть свой силуэт для того, кто смотрит снизу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świeci na brzuchu, by od dołu zatrzeć własny zarys sylwetki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gloeit op zijn buik om zijn eigen silhouet van onderaf te wissen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdan bakıldığında gölgesini silmek için karnında ışık saçar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पेट पर चमककर नीचे से अपनी ही परछाईं मिटा देती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腹を光らせ、下から見た自分の影を消し去る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배에서 빛을 내어 아래에서 보이는 자기 그림자를 지운다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腹部发光，抹去自己从下方看去的剪影。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腹部發光，以消除自己從下方看去的剪影。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوهّج من بطنها لتمحو ظلّها عند النظر إليها من الأسفل."
          }
        }
      }
    },
