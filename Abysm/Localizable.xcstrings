    "landmark.johnston.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deepest shipwreck ever found, lost in WWII's Battle off Samar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pecio más profundo hallado, perdido en la batalla de Samar de la Segunda Guerra Mundial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'épave la plus profonde jamais découverte, coulée à la bataille de Samar (Seconde Guerre mondiale)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das tiefste je entdeckte Schiffswrack, verloren in der Schlacht vor Samar im Zweiten Weltkrieg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relitto più profondo mai trovato, perduto nella Battaglia di Samar della Seconda Guerra Mondiale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O naufrágio mais profundo já encontrado, perdido na Batalha de Samar na 2ª Guerra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубочайший из найденных кораблей, погиб в бою у Самара во Второй мировой."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najgłębiej odnaleziony wrak statku, zatopiony w bitwie pod Samarem podczas II wojny światowej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het diepste scheepswrak ooit gevonden, verloren in de Slag bij Samar in WO II."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye dek bulunan en derin gemi enkazı; 2. Dünya Savaşı'nda Samar Muharebesi'nde battı."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तक मिला सबसे गहरा जहाज़ी मलबा, द्वितीय विश्वयुद्ध की समर के निकट लड़ाई में डूबा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまで発見された最深の沈没船。第二次大戦のサマール沖海戦で沈んだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 발견된 가장 깊은 난파선으로, 2차 대전 사마르 해전에서 침몰했다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迄今发现的最深沉船，在二战萨马岛海战中沉没。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "迄今發現最深的沉船，於二戰薩馬島海戰中沉沒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعمق حطام سفينة عُثر عليه، فُقدت في معركة سامار في الحرب العالمية الثانية."
          }
        }
      }
    },
