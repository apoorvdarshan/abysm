    "creature.elephantseal.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds its breath up to two hours, diving 2 km after fish and squid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguanta la respiración hasta dos horas y bucea 2 km tras peces y calamares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il retient son souffle jusqu'à deux heures, plongeant à 2 km après poissons et calmars."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Atem bis zu zwei Stunden und taucht 2 km tief nach Fisch und Tintenfisch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trattiene il respiro fino a due ore, immergendosi a 2 km per pesci e calamari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prende a respiração por até duas horas, mergulhando 2 km atrás de peixes e lulas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задерживает дыхание до двух часов, ныряя на 2 км за рыбой и кальмарами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje oddech nawet na dwie godziny, nurkując 2 km za rybami i kałamarnicami."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt tot twee uur de adem in en duikt 2 km achter vis en inktvis aan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balık ve kalamar peşinde 2 km dalıp nefesini iki saate kadar tutar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो घंटे तक साँस रोकता है, मछली और स्क्विड के पीछे 2 कि.मी. गहरा गोता लगाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最長2時間も息を止め、魚やイカを追って2km潜る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물고기와 오징어를 쫓아 2 km까지 잠수하며 최대 두 시간 숨을 참는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可屏息长达两小时，下潜2公里追捕鱼类和乌贼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憋氣可達兩小時，潛 2 km 深追捕魚與魷。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتم أنفاسه حتى ساعتين، غائصًا 2 كم خلف السمك والحبّار."
          }
        }
      }
    },
