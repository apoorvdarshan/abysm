    "creature.haddock.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A North Atlantic cod relative marked by a dark 'thumbprint' on its side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pariente del bacalao del Atlántico Norte, marcado por una \"huella\" oscura en el costado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cousin de la morue de l'Atlantique Nord, marqué d'une « empreinte » sombre sur le flanc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nordatlantischer Dorschverwandter mit einem dunklen „Daumenabdruck“ an der Seite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un parente del merluzzo del Nord Atlantico, con una scura 'impronta' sul fianco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parente do bacalhau do Atlântico Norte, marcado por uma 'dedada' escura no flanco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Североатлантический родич трески с тёмным «отпечатком пальца» на боку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Północnoatlantycki krewny dorsza, rozpoznawalny po ciemnym „odcisku palca” na boku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Noord-Atlantische kabeljauwverwant met een donkere 'duimafdruk' op de flank."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanında koyu bir 'parmak izi' lekesiyle tanınan Kuzey Atlantik morina akrabasıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तरी अटलांटिक का कॉड-रिश्तेदार, जिसकी बगल पर गहरे रंग का 'अँगूठा-निशान' होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "北大西洋のタラの仲間。体側の黒い「指紋」模様が目印。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆구리에 검은 '엄지자국' 무늬가 있는 북대서양 대구의 친척."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "北大西洋的鳕鱼近亲，体侧有一块深色的“拇指印”斑纹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "北大西洋的鱈魚近親，身側有醒目的深色「指印」斑。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قريب لسمك القد في شمال الأطلسي يميّزه أثر داكن كبصمة إبهام على جانبه."
          }
        }
      }
    },
