    "creature.blobfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks gelatinous only at the surface — under deep pressure it's a normal fish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo parece gelatinoso en la superficie; bajo la presión profunda es un pez normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gélatineux seulement en surface — sous la pression des profondeurs, c'est un poisson ordinaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirkt nur an der Oberfläche gallertartig — unter Tiefendruck ist er ein normaler Fisch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra gelatinoso solo in superficie: sotto pressione è un pesce normale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só parece gelatinoso à superfície — sob a pressão das profundezas é um peixe normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Студенистой кажется лишь у поверхности — на глубине под давлением это обычная рыба."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Galaretowaty tylko przy powierzchni — pod głębokim ciśnieniem to zwyczajna ryba."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijkt alleen aan het oppervlak gelei-achtig — onder diepe druk is het een gewone vis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece yüzeyde jölemsi görünür; derindeki basınç altında sıradan bir balıktır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जेली-सी सिर्फ़ सतह पर दिखती है — गहरे दबाव में यह एक सामान्य मछली है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゼリー状に見えるのは水面だけ。深海の水圧下では普通の魚だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐물흐물해 보이는 건 수면에서뿐, 깊은 압력 속에서는 평범한 물고기다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有出水后才显得像果冻——在深海高压下它就是条普通的鱼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在水面才顯得軟塌——在深海高壓下牠是條正常的魚。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو هلامية عند السطح فقط؛ وتحت ضغط الأعماق هي سمكة عادية."
          }
        }
      }
    },
