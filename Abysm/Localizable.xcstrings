    "creature.greenlandshark.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May live over 400 years — the longest-lived vertebrate known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede vivir más de 400 años: el vertebrado más longevo conocido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vivrait plus de 400 ans — le vertébré le plus longévif connu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann über 400 Jahre alt werden — das langlebigste bekannte Wirbeltier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può vivere oltre 400 anni: il vertebrato più longevo conosciuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode viver mais de 400 anos — o vertebrado mais longevo conhecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может жить более 400 лет — самое долгоживущее из известных позвоночных."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może żyć ponad 400 lat — najdłużej żyjący znany kręgowiec."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ruim 400 jaar leven — het langstlevende bekende gewervelde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "400 yılı aşabilir; bilinen en uzun yaşayan omurgalıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "400 साल से ज़्यादा जी सकती है — ज्ञात सबसे लंबा जीने वाला कशेरुकी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "400年以上生きることもある、知られる限り最も長寿の脊椎動物。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "400년 넘게 살 수 있다 — 알려진 가장 오래 사는 척추동물."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或可存活400多年——已知寿命最长的脊椎动物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壽命可超過 400 年——是已知最長壽的脊椎動物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يعيش أكثر من 400 عام، أطول الفقاريات المعروفة عمرًا."
          }
        }
      }
    },
