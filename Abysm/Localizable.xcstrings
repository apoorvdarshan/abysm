    "creature.chickenfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A swimming sea cucumber nicknamed for its odd, plucked-poultry shape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pepino de mar nadador apodado así por su rara forma de ave desplumada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concombre de mer nageur surnommé ainsi pour sa drôle d'allure de volaille plumée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine schwimmende Seegurke, benannt nach ihrer seltsamen, gerupften Hühnchen-Form."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cetriolo di mare natante, soprannominato così per la buffa forma da pollo spennato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pepino-do-mar nadador apelidado por sua forma estranha de ave depenada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающая голотурия, прозванная так за нелепый вид ощипанной птицы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pływający ogórek morski przezwany tak za dziwny kształt oskubanego drobiu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zwemmende zeekomkommer, bijgenaamd naar zijn vreemde, geplukte-kipachtige vorm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhaf, yolunmuş tavuk görüntüsüyle anılan, yüzen bir deniz hıyarıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक तैरती समुद्री ककड़ी, जिसका उपनाम इसकी अजीब, नुची-मुर्गी जैसी आकृति पर पड़ा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "泳ぐナマコの一種。毛をむしった鶏に似た奇妙な姿が名の由来。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤엄치는 해삼으로, 털 뽑힌 닭 같은 기묘한 모양에서 별명이 붙었다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种会游泳的海参，因形似拔了毛的鸡而得此绰号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一種會游泳的海參，因奇特如拔毛家禽的外形而得名。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيار بحر سبّاح لُقّب بذلك لشكله الغريب الشبيه بدجاجة منتوفة."
          }
        }
      }
    },
