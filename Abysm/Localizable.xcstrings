    "creature.telescopeoctopus.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparent, with tubular eyes that swivel to point upward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparente, con ojos tubulares que giran para apuntar hacia arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparente, aux yeux tubulaires qui pivotent pour regarder vers le haut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsichtig, mit röhrenförmigen Augen, die sich nach oben drehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasparente, con occhi tubolari che ruotano per puntare verso l'alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparente, com olhos tubulares que giram para apontar para cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прозрачный, с трубчатыми глазами, что поворачиваются вверх."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przezroczysta, z rurkowatymi oczami, które obracają się ku górze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorzichtig, met buisvormige ogen die naar boven kunnen draaien."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeffaftır; yukarı dönen boru biçimli gözlere sahiptir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पारदर्शी, नली-नुमा आँखों के साथ जो घूमकर ऊपर की ओर ताकती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明な体に、上を向く筒状の目を持つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸이 투명하며, 위쪽을 향해 돌아가는 원통형 눈을 지녔다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通体透明，长着可转动朝上的管状眼睛。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通體透明，管狀的眼睛能轉向上方。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شفّاف، وله عينان أنبوبيتان تدوران لتتّجها إلى الأعلى."
          }
        }
      }
    },
