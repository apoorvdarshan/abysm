    "creature.salmon.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Born in rivers, it swims thousands of miles out to sea and back to spawn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nace en los ríos, nada miles de kilómetros hasta el mar y vuelve para desovar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Né en rivière, il parcourt des milliers de kilomètres vers la mer puis revient frayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Flüssen geboren, schwimmt er tausende Kilometer ins Meer und zum Laichen zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasce nei fiumi, percorre migliaia di chilometri in mare e torna a deporre le uova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasce nos rios, nada milhares de quilômetros até o mar e volta para desovar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рождается в реках, уплывает за тысячи километров в море и возвращается на нерест."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urodzony w rzece pokonuje tysiące kilometrów w morze i z powrotem, by się rozmnożyć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geboren in rivieren, zwemt hij duizenden kilometers naar zee en terug om te paaien."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehirlerde doğar, binlerce kilometre denize gider ve yumurtlamak için geri döner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नदियों में जन्मी, यह हज़ारों मील समुद्र तक जाकर अंडे देने लौट आती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "川で生まれ、何千キロも泳いで海へ出て、産卵に戻る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강에서 태어나 수천 km를 헤엄쳐 바다로 나갔다가 산란하러 돌아온다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在河流中出生，会游数千公里入海，再洄游回来产卵。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出生於河流，游數千里入海，再洄游回來產卵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُولد في الأنهار، يسبح آلاف الأميال إلى البحر ويعود ليتكاثر."
          }
        }
      }
    },
