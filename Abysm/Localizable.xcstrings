    "creature.beakedwhale.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deepest-diving mammal, recorded almost 3 km down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mamífero que bucea más hondo, registrado a casi 3 km de profundidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mammifère qui plonge le plus profond, enregistré à près de 3 km."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das am tiefsten tauchende Säugetier, fast 3 km tief nachgewiesen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mammifero che si immerge più in profondità, registrato a quasi 3 km."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mamífero que mergulha mais fundo, registrado a quase 3 km de profundidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое глубоконыряющее млекопитающее — зафиксировано почти на 3 км."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najgłębiej nurkujący ssak, zarejestrowany prawie 3 km w głąb."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het diepst duikende zoogdier, gemeten op bijna 3 km diepte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En derine dalan memeli; neredeyse 3 km derinde kaydedildi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे गहरा गोता लगाने वाला स्तनधारी, लगभग 3 कि.मी. नीचे तक दर्ज।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も深く潜る哺乳類。約3kmの深さまで記録された。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 깊이 잠수하는 포유류로, 거의 3 km 깊이까지 기록되었다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "潜得最深的哺乳动物，记录将近3公里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "潛得最深的哺乳動物，紀錄將近 3 km 深。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعمق الثدييات غوصًا، سُجّل على عمق يقارب 3 كم."
          }
        }
      }
    },
