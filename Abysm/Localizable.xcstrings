    "creature.facelessfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its eyes and nostrils hide under the skin — so it appears to have no face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus ojos y orificios nasales se ocultan bajo la piel, así que parece no tener cara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses yeux et ses narines se cachent sous la peau — il semble n'avoir aucun visage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Augen und Nasenlöcher verbergen sich unter der Haut — so scheint er kein Gesicht zu haben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occhi e narici nascosti sotto la pelle: così sembra non avere volto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus olhos e narinas ficam sob a pele — por isso parece não ter rosto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глаза и ноздри скрыты под кожей — потому кажется, что у неё нет лица."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego oczy i nozdrza kryją się pod skórą — dlatego zdaje się nie mieć twarzy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn ogen en neusgaten verbergen zich onder de huid — zo lijkt hij geen gezicht te hebben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözleri ve burun delikleri derisinin altında gizlidir; bu yüzden yüzü yokmuş gibi görünür."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी आँखें और नथुने त्वचा के नीचे छिपे हैं — इसलिए यह चेहराविहीन लगती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目と鼻孔が皮膚の下に隠れ、顔がないように見える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈과 콧구멍이 피부 아래 숨어 있어 얼굴이 없는 것처럼 보인다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼睛和鼻孔都藏在皮肤之下——看起来仿佛没有脸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "眼睛和鼻孔藏在皮膚下——所以看起來像沒有臉。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختبئ عيناه ومنخراه تحت الجلد، فيبدو وكأنه بلا وجه."
          }
        }
      }
    },
    "creature.brittlestar.name": {
