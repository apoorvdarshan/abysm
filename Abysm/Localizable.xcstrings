    "creature.gulpereel.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A huge balloon-like mouth lets it swallow prey larger than itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una enorme boca como un globo le permite tragar presas más grandes que él mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une énorme bouche en ballon lui permet d'avaler des proies plus grosses que lui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein riesiges ballonartiges Maul lässt ihn Beute verschlingen, die größer ist als er selbst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bocca enorme a palloncino le permette di inghiottire prede più grandi di sé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma boca enorme em forma de balão lhe permite engolir presas maiores que ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Огромная пасть-мешок позволяет заглатывать добычу крупнее себя."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogromna, balonowata paszcza pozwala mu połykać zdobycz większą od niego samego."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een enorme ballonachtige bek laat hem prooi groter dan zichzelf verzwelgen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balon gibi devasa ağzı, kendinden büyük avları yutmasını sağlar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुब्बारे-सा विशाल मुँह इसे अपने से बड़े शिकार को निगलने देता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風船のような巨大な口で、自分より大きな獲物も丸呑みにする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풍선처럼 거대한 입으로 자기보다 큰 먹이도 삼킨다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "气球般的巨大口部，能吞下比自己更大的猎物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "氣球般的巨大口部，讓牠能吞下比自己還大的獵物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فمٌ ضخم كالبالون يتيح له ابتلاع فريسة أكبر منه."
          }
        }
      }
    },
