    "creature.goblinshark.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoots its jaws forward to snatch prey; another deep-sea 'living fossil.'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyecta las mandíbulas hacia delante para atrapar presas; otro \"fósil viviente\" del abismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il projette ses mâchoires en avant pour saisir ses proies ; un autre « fossile vivant » des abysses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schleudert die Kiefer vor, um Beute zu schnappen; ein weiteres „lebendes Fossil“ der Tiefsee."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proietta in avanti le mascelle per afferrare le prede; un altro 'fossile vivente' abissale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeta as mandíbulas para frente para abocanhar presas; outro 'fóssil vivo' das profundezas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрасывает челюсти вперёд, чтобы схватить добычу; ещё одно глубинное «живое ископаемое»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrzuca szczęki do przodu, by porwać zdobycz; kolejna głębinowa „żywa skamieniałość”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiet zijn kaken naar voren om prooi te grijpen; nog een diepzee-'levend fossiel'."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avı kapmak için çenelerini öne fırlatır; bir başka derin deniz 'yaşayan fosili'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शिकार झपटने को अपने जबड़े आगे फेंकती है; एक और गहरे-समुद्र की 'जीवित जीवाश्म'।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あごを前方に突き出して獲物を捕らえる、もう一つの深海の「生きた化石」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턱을 앞으로 쏘아 먹이를 낚아챈다. 또 다른 심해 '살아있는 화석'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能把颌部向前弹出攫取猎物；又一种深海“活化石”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能將顎部向前彈出捕食；另一種深海「活化石」。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدفع فكّيه إلى الأمام ليخطف الفريسة؛ \"أحفورة حية\" أخرى من الأعماق."
          }
        }
      }
    },
