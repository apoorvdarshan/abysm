    "creature.giantoctopus.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The largest octopus; it can squeeze through any gap bigger than its beak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pulpo más grande; puede colarse por cualquier hueco mayor que su pico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plus grande pieuvre ; elle se faufile par tout interstice plus large que son bec."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der größte Krake; er zwängt sich durch jede Spalte, die größer als sein Schnabel ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il polpo più grande; passa per ogni fessura più larga del suo becco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O maior polvo; passa por qualquer fresta maior que seu bico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупнейший осьминог; протискивается в любую щель шире своего клюва."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największa ośmiornica; potrafi przecisnąć się przez każdą szczelinę większą niż jej dziób."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grootste octopus; hij wringt zich door elke opening groter dan zijn snavel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En büyük ahtapottur; gagasından büyük her aralıktan sızabilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे बड़ा ऑक्टोपस; यह अपनी चोंच से बड़े किसी भी छेद से निकल सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大のタコ。くちばしより大きな隙間ならどこでもすり抜ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 문어. 부리보다 큰 틈이면 어디든 비집고 빠져나간다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大的章鱼；能挤过任何比它喙更大的缝隙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大的章魚；能擠過任何比牠喙大的縫隙。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكبر أخطبوط؛ ينسلّ عبر أي فجوة أكبر من منقاره."
          }
        }
      }
    },
    "creature.oarfish.name": {
