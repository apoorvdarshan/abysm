    "landmark.titanic.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wreck has rested on the seafloor here since 1912."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los restos del naufragio reposan aquí en el fondo desde 1912."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'épave repose ici sur le fond marin depuis 1912."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wrack ruht hier seit 1912 auf dem Meeresgrund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relitto riposa qui sul fondale dal 1912."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os destroços repousam no fundo do mar aqui desde 1912."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обломки покоятся здесь на дне с 1912 года."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrak spoczywa tu na dnie morza od 1912 roku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wrak rust hier sinds 1912 op de zeebodem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkaz 1912'den beri burada deniz tabanında yatıyor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मलबा 1912 से यहीं समुद्रतल पर पड़ा है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この船の残骸は1912年からここの海底に眠っている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 잔해는 1912년부터 이곳 해저에 잠들어 있다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自1912年起，这艘沉船便长眠于此处的海底。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這艘沉船自 1912 年起便長眠於此處海底。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرقد حطامها على القاع هنا منذ عام 1912."
          }
        }
      }
    },
