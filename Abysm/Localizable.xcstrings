    "creature.barracuda.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fierce ambush hunter with a mouthful of dagger-like teeth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un feroz cazador al acecho con la boca llena de dientes como dagas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Féroce chasseur à l'affût, la gueule hérissée de dents en poignard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wilder Lauerjäger mit einem Maul voller dolchartiger Zähne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un feroce cacciatore d'agguato con una bocca piena di denti aguzzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caçadora feroz de emboscada com uma boca cheia de dentes como adagas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свирепый хищник из засады с пастью, полной кинжальных зубов."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaciekły myśliwy z zasadzki o paszczy pełnej sztyletowatych zębów."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een felle hinderlaagjager met een bek vol dolkachtige tanden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hançer gibi dişlerle dolu, pusu kuran azılı bir avcıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खंजर-से दाँतों से भरे मुँह वाला एक खूँखार घात लगाकर शिकार करने वाला जीव।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短剣のような歯を並べた、獰猛な待ち伏せ型のハンター。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단검 같은 이빨이 가득한 입을 지닌 사나운 매복 사냥꾼."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凶猛的伏击猎手，满口匕首般的利齿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兇猛的伏擊獵手，滿口匕首般的利齒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صيّادة كمين شرسة بفمٍ مليء بأسنان كالخناجر."
          }
        }
      }
    },
