    "creature.anglerfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dangles a glowing lure to draw prey into total darkness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balancea un señuelo luminoso para atraer presas a la oscuridad total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle balance un leurre lumineux pour attirer ses proies dans le noir total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt einen leuchtenden Köder baumeln, um Beute in die totale Dunkelheit zu locken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa penzolare un'esca luminosa per attirare le prede nel buio totale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Balança uma isca luminosa para atrair presas para a escuridão total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Качает светящейся приманкой, заманивая добычу в полную тьму."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwabia zdobycz świecącą przynętą w zupełnej ciemności."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bungelt met een gloeiend lokaas om prooi het volledige duister in te lokken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avı tam karanlığa çekmek için ışıldayan bir yem sallandırır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घुप्प अँधेरे में शिकार खींचने को एक चमकता लालच लटकाती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光る誘いを垂らし、漆黒の闇へ獲物をおびき寄せる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛나는 미끼를 흔들어 칠흑 같은 어둠 속으로 먹이를 끌어들인다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垂下发光的诱饵，把猎物引入彻底的黑暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垂下發光的誘餌，將獵物引入全然的黑暗。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدلّي طُعمًا متوهّجًا لتجذب الفريسة في الظلام الدامس."
          }
        }
      }
    },
