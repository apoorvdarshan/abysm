    "creature.amphipod.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shrimp-like scavenger thriving at the very bottom of the trenches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un carroñero parecido a una gamba que prospera en el mismo fondo de las fosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charognard semblable à une crevette qui prospère tout au fond des fosses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein garnelenartiger Aasfresser, der am tiefsten Grund der Gräben gedeiht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spazzino simile a un gamberetto che prospera sul fondo delle fosse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necrófago parecido com camarão que prospera no fundo das fossas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Креветкоподобный падальщик, что процветает на самом дне впадин."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krewetkowaty padlinożerca, który świetnie radzi sobie na samym dnie rowów."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een garnaalachtige aaseter die gedijt op de allerdiepste bodem van de troggen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çukurların en dibinde gelişen, karidesi andıran bir leşçidir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक झींगा-सा अपमार्जक जो खाइयों की एकदम तलहटी में पनपता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海溝の最深部で繁栄する、エビに似た腐肉食動物。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해구 맨 밑바닥에서 번성하는 새우 같은 청소동물."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形似虾的食腐动物，在海沟的最底部繁盛生长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "形似蝦的食腐動物，在海溝最深處繁盛生長。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانس يشبه الجمبري يزدهر في أعمق قاع الخنادق."
          }
        }
      }
    },
