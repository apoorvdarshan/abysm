    "creature.sealion.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steers with its front flippers and can dive well past 130 m for fish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se impulsa con las aletas delanteras y bucea más allá de 130 m en busca de peces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se dirige avec ses nageoires avant et plonge bien au-delà de 130 m pour pêcher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenkt mit den Vorderflossen und taucht für Fisch weit über 130 m tief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dirige con le pinne anteriori e può immergersi oltre 130 m per cacciare pesci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guia-se pelas nadadeiras dianteiras e mergulha bem além de 130 m atrás de peixes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правит передними ластами и ныряет за рыбой глубже 130 м."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steruje przednimi płetwami i potrafi nurkować po ryby znacznie głębiej niż 130 m."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt met zijn voorvinnen en kan ruim 130 m diep duiken voor vis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön yüzgeçleriyle yön verir ve balık için 130 m'nin ötesindeki derinliğe dalabilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने अगले फ़्लिपरों से दिशा बदलता है और मछली के लिए 130 मी से भी गहरा गोता लगाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前ヒレで巧みに泳ぎ、魚を求めて130m以上も潜る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞지느러미로 방향을 잡고, 물고기를 쫓아 130 m 넘게 잠수한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠一对前鳍肢掌舵，为捕鱼可潜入130米以下的深处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用前鰭掌控方向，能潛超過 130 m 深捕魚。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجّه نفسه بزعانفه الأمامية ويغوص لما يتجاوز 130 م بحثًا عن السمك."
          }
        }
      }
    },
