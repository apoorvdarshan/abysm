    "creature.barreleye.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sees upward through its own transparent, fluid-filled forehead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira hacia arriba a través de su propia frente transparente y llena de fluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il voit vers le haut à travers son propre front transparent rempli de fluide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht durch seine eigene durchsichtige, flüssigkeitsgefüllte Stirn nach oben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda verso l'alto attraverso la propria fronte trasparente piena di fluido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enxerga para cima através da própria testa transparente, cheia de fluido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрит вверх сквозь собственный прозрачный лоб, наполненный жидкостью."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrzy do góry przez własne przezroczyste, wypełnione płynem czoło."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijkt omhoog door zijn eigen doorzichtige, met vloeistof gevulde voorhoofd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi şeffaf, sıvı dolu alnından yukarı bakar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ही पारदर्शी, तरल-भरे माथे के आर-पार ऊपर देखती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明で液体に満ちた額越しに、上方を見渡す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액체로 찬 투명한 이마를 통해 위쪽을 본다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透过自己透明、充满液体的额部向上观望。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過自己透明、充滿液體的額頭向上窺視。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظر إلى الأعلى عبر جبهتها الشفّافة المملوءة بالسائل."
          }
        }
      }
    },
