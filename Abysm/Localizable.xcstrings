    "creature.squidworm.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half-squid, half-worm in looks — it rows through the deep on feathery paddles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitad calamar, mitad gusano; rema por el abismo con paletas plumosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi-calmar, mi-ver d'aspect — il rame dans l'abysse sur des palettes plumeuses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halb Kalmar, halb Wurm im Aussehen — er rudert mit federartigen Paddeln durch die Tiefe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per metà calamaro e per metà verme, si fa largo nel profondo con pagaie piumose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Metade lula, metade verme na aparência — rema pelas profundezas com remos emplumados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С виду полукальмар-получервь — гребёт сквозь глубину перистыми вёслами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z wyglądu pół kałamarnica, pół robak — wiosłuje przez głębinę pierzastymi wiosełkami."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Half inktvis, half worm van uiterlijk — hij roeit door de diepte op vederachtige peddels."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarı kalamar yarı kurt görünümlü; tüysü kürekleriyle derinlerde kürek çeker."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखने में आधा-स्क्विड, आधा-कीड़ा — पंखदार चप्पुओं से गहराई में खेता हुआ चलता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目は半分イカ、半分ミミズ。羽状の櫂で深海を漕ぎ進む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오징어 반, 벌레 반인 모습으로, 깃털 같은 노를 저어 심해를 누빈다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外形半像乌贼半像蠕虫——靠羽状的桨足在深海中划行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外形半魷半蟲——靠羽狀的槳在深海中划行。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصف حبّار ونصف دودة في الشكل، تجدّف في الأعماق بمجاديف ريشية."
          }
        }
      }
    },
    "landmark.deepest_scuba.name": {
      "extractionState": "manual",
      "localizations": {
