    "creature.tripodfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perches on three stilt-like fins, facing the current and waiting for food to drift in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se posa sobre tres aletas como zancos, de cara a la corriente, esperando que llegue el alimento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché sur trois nageoires en échasses, il fait face au courant en attendant que la nourriture dérive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht auf drei stelzenartigen Flossen, der Strömung zugewandt, und wartet auf herantreibende Nahrung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si appoggia su tre pinne a trampolo, rivolto alla corrente, in attesa del cibo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empoleira-se em três nadadeiras feito pernas de pau, de frente para a correnteza, esperando comida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит на трёх плавниках-ходулях против течения, ожидая, когда оно принесёт еду."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspiera się na trzech szczudłowatych płetwach, zwrócony do prądu, czekając na niesione pożywienie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat op drie stelten-achtige vinnen, met de kop in de stroming, wachtend tot voedsel aandrijft."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç çubuk benzeri yüzgeçte tüneyip akıntıya döner ve yiyeceğin gelmesini bekler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन डंडी-नुमा पंखों पर टिककर धारा की ओर मुँह किए भोजन बहकर आने का इंतज़ार करती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三本の脚状のヒレで立ち、流れに向かい餌が流れ来るのを待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장대 같은 세 지느러미로 서서 물살을 마주한 채 떠오는 먹이를 기다린다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用三根高跷般的鳍立着，迎向水流，等候食物随流漂来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用三根高蹺般的鰭撐立，面向水流，等候食物漂來。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتّكئ على ثلاث زعانف كالأعمدة، تواجه التيار وتنتظر انجراف الطعام إليها."
          }
        }
      }
    },
