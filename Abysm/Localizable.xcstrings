    "creature.coral.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A colony of tiny animals; coral reefs shelter about a quarter of all sea life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una colonia de animales diminutos; los arrecifes cobijan casi un cuarto de la vida marina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une colonie de petits animaux ; les récifs abritent près d'un quart de la vie marine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kolonie winziger Tiere; Korallenriffe beherbergen etwa ein Viertel allen Meereslebens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una colonia di animaletti; le barriere coralline ospitano circa un quarto della vita marina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma colônia de minúsculos animais; recifes abrigam cerca de um quarto da vida marinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колония крошечных животных; коралловые рифы укрывают около четверти морской жизни."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolonia maleńkich zwierząt; rafy koralowe dają schronienie niemal jednej czwartej życia w morzu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kolonie kleine diertjes; koraalriffen herbergen ongeveer een kwart van al het zeeleven."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minik canlılardan oluşan bir koloni; mercan resifleri deniz yaşamının dörtte birine yuva olur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नन्हे जीवों की एक बस्ती; मूँगा-भित्तियाँ लगभग एक-चौथाई समुद्री जीवन को आश्रय देती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな動物の群体。サンゴ礁は海洋生物の約4分の1を支える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 동물들의 군체. 산호초는 전체 해양 생물의 약 4분의 1을 품는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由微小动物组成的群落；珊瑚礁庇护着约四分之一的海洋生物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由無數微小動物組成的群落；珊瑚礁庇護了約四分之一的海洋生命。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستعمرة من حيوانات دقيقة؛ تأوي الشعاب المرجانية نحو رُبع حياة البحر."
          }
        }
      }
    },
