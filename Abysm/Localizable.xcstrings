    "creature.beluga.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 'canary of the sea' — it chirps and whistles, and can even turn its head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El \"canario del mar\": pía y silba, e incluso puede girar la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le « canari des mers » — il pépie et siffle, et peut même tourner la tête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der „Kanarienvogel des Meeres“ — er zwitschert und pfeift und kann sogar den Kopf drehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 'canarino del mare': cinguetta e fischia, e riesce persino a girare la testa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O 'canário do mar' — chilreia e assobia, e até consegue virar a cabeça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Морская канарейка» — щебечет и свистит, и даже может поворачивать голову."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kanarek mórz” — ćwierka i gwiżdże, a nawet potrafi obracać głowę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 'kanarie van de zee' — hij tjilpt en fluit, en kan zelfs zijn kop draaien."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Denizin kanaryası'; cıvıldar ve ıslık çalar, hatta başını çevirebilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'समुद्र की कैनरी' — यह चहकती और सीटी बजाती है, और अपना सिर भी घुमा सकती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「海のカナリア」。さえずりや口笛のような声を出し、首を回すこともできる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'바다의 카나리아' — 짹짹거리고 휘파람을 내며, 고개도 돌릴 수 있다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“海中金丝雀”——会啁啾鸣叫与吹哨，甚至能转动头部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「海中金絲雀」——會啁啾與吹哨，甚至能轉動頭部。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"كناري البحر\"، يزقزق ويصفر، بل يستطيع أن يدير رأسه."
          }
        }
      }
    },
