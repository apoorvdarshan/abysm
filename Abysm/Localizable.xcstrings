    "zone.hadal.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepest trenches: crushing, lightless, barely alive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fosas más profundas: aplastantes, sin luz, apenas con vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fosses les plus profondes : écrasantes, sans lumière, à peine vivantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefste Gräben: erdrückend, lichtlos, kaum belebt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fosse profondissime: schiaccianti, senza luce, quasi prive di vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fossas mais fundas: esmagadoras, sem luz, quase sem vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубочайшие впадины: давящие, без света, едва живые."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najgłębsze rowy: miażdżące, bezświetlne, ledwie żywe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diepste troggen: verpletterend, lichtloos, amper leven."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En derin çukurlar: ezici, ışıksız, neredeyse cansız."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे गहरी खाइयाँ: कुचलता दबाव, अँधेरा, मुश्किल से जीवन।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も深い海溝。押しつぶす闇、ほとんど命のない世界。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 깊은 해구: 짓누르고, 빛 없고, 겨우 생명이 깃든 곳."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最深的海沟：压力极大、毫无光线、生命罕存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最深的海溝：高壓、無光、生命稀微。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعمق الخنادق: ضغطٌ ساحق، بلا ضوء، وحياة بالكاد."
          }
        }
      }
    },
    "creature.salmon.name": {
      "extractionState": "manual",
