    "creature.spidercrab.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The largest crab on Earth — its legs can span over 3 metres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cangrejo más grande de la Tierra: sus patas pueden superar los 3 metros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus grand crabe sur Terre — ses pattes peuvent s'étendre sur plus de 3 mètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die größte Krabbe der Erde — ihre Beine können über 3 Meter spannen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il granchio più grande della Terra: le zampe possono superare i 3 metri di apertura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O maior caranguejo da Terra — suas patas podem se estender por mais de 3 metros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупнейший краб на Земле — размах его ног превышает 3 метра."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największy krab na Ziemi — rozpiętość jego nóg przekracza 3 metry."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grootste krab op aarde — zijn poten kunnen ruim 3 meter spannen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünya'nın en büyük yengecidir; bacakları 3 metreden fazla açılabilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धरती का सबसे बड़ा केकड़ा — इसकी टाँगों का फैलाव 3 मीटर से ज़्यादा हो सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球最大のカニ。脚を広げると3mを超えることもある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구상 가장 큰 게 — 다리를 펼치면 3 m가 넘는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地球上最大的螃蟹——足展可超过3米。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地球上最大的螃蟹——腳展開可超過 3 公尺。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكبر سرطان على الأرض، يمتد عرض أرجله إلى أكثر من 3 أمتار."
          }
        }
      }
    },
