    "creature.spermwhale.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The largest toothed predator; it dives ~2 km to hunt giant squid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mayor depredador con dientes; bucea unos 2 km para cazar calamares gigantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus grand prédateur à dents ; il plonge à ~2 km pour chasser le calmar géant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das größte zahntragende Raubtier; er taucht ~2 km tief, um Riesenkalmare zu jagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il più grande predatore con denti; si immerge a ~2 km per cacciare i calamari giganti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O maior predador dentado; mergulha cerca de 2 km para caçar lulas gigantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупнейший зубатый хищник; ныряет на ~2 км, охотясь на гигантских кальмаров."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największy drapieżnik uzębiony; nurkuje na ~2 km, by polować na olbrzymie kałamarnice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het grootste tandroofdier; hij duikt ~2 km om reuzeninktvis te jagen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En büyük dişli avcıdır; dev kalamar avlamak için ~2 km dalar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे बड़ा दाँतवाला शिकारी; विशाल स्क्विड के शिकार को ~2 कि.मी. गहरा गोता लगाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大の歯を持つ捕食者。ダイオウイカを狩りに約2km潜る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 이빨 포식자. 대왕오징어를 사냥하러 약 2 km까지 잠수한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大的齿类掠食者；为捕猎大王乌贼可下潜约2公里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大的齒類掠食者；潛約 2 km 深獵捕大王魷。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكبر مفترس مسنّن؛ يغوص نحو 2 كم ليصطاد الحبّار العملاق."
          }
        }
      }
    },
