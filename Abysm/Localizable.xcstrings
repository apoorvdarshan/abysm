    "creature.giantisopod.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep-sea cousin of the woodlouse that can go years between meals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un primo abisal de la cochinilla que puede pasar años entre comidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cousin abyssal du cloporte qui peut passer des années sans manger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tiefsee-Verwandter der Kellerassel, der Jahre zwischen den Mahlzeiten überdauern kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cugino abissale dell'onisco che può digiunare per anni tra un pasto e l'altro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primo abissal do tatuzinho que passa anos sem comer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубоководный родич мокрицы, что годами обходится без пищи."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głębinowy kuzyn stonogi, który potrafi nie jeść przez całe lata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een diepzeeneef van de pissebed die jaren tussen maaltijden kan zitten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtakurusunun derin deniz akrabasıdır; öğünler arası yıllarca dayanabilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लकड़ी-जूँ का गहरे-समुद्री चचेरा भाई जो भोजन के बीच सालों रह सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワラジムシの深海の仲間。何年も食べずに生きられる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쥐며느리의 심해 사촌으로, 몇 년씩 먹지 않고 버틸 수 있다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠妇的深海表亲，可数年不进食。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠婦的深海近親，可數年不進食。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قريب أعماقي لقملة الخشب يصمد سنوات بين وجبة وأخرى."
          }
        }
      }
    },
