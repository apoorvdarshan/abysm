    "creature.clownfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lives unharmed among a sea anemone's stinging tentacles, which guard it from predators."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive ileso entre los tentáculos urticantes de una anémona, que lo protege de depredadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vit indemne parmi les tentacules urticants de l'anémone, qui le protègent des prédateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebt unversehrt zwischen den Nesseltentakeln einer Seeanemone, die ihn vor Räubern schützt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive illeso tra i tentacoli urticanti dell'anemone, che lo proteggono dai predatori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive ileso entre os tentáculos urticantes da anêmona, que o protege de predadores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живёт невредимой среди жгучих щупалец актинии, которые защищают её от хищников."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żyje bez szwanku wśród parzących czułek ukwiała, które chronią go przed drapieżnikami."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeft ongedeerd tussen de brandende tentakels van een zeeanemoon, die hem beschermen tegen roofdieren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakıcı deniz anemonu kolları arasında zarar görmeden yaşar; bu kollar onu avcılardan korur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समुद्री एनीमोन के डंक भरे तंतुओं के बीच बेखौफ़ रहती है, जो इसे शिकारियों से बचाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イソギンチャクの刺す触手の中で無事に暮らし、外敵から守られる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말미잘의 쏘는 촉수 사이에서 멀쩡히 살며, 포식자로부터 보호받는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安然生活在海葵带刺的触手间，借此抵御天敌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安然生活在海葵的螫刺觸手間，受其保護免於天敵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيش سالمة بين لوامس شقائق البحر اللاسعة التي تحميها من المفترسات."
          }
        }
      }
    },
