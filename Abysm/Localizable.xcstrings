    "creature.mahimahi.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the fastest-growing fish, blazing with green-gold color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno de los peces de crecimiento más rápido, reluciente de color verde dorado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'un des poissons à la croissance la plus rapide, flamboyant de vert et d'or."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einer der am schnellsten wachsenden Fische, leuchtend in Grüngold."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno dei pesci a crescita più rapida, sfavillante di colori verde-oro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos peixes de crescimento mais rápido, reluzente em verde-dourado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна из самых быстрорастущих рыб, сверкающая зелёно-золотым цветом."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna z najszybciej rosnących ryb, mieniąca się zielono-złotym blaskiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van de snelst groeiende vissen, schitterend in groen-goud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En hızlı büyüyen balıklardan biri; yeşil-altın renklerle parlar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे तेज़ी से बढ़ने वाली मछलियों में से एक, हरे-सुनहरे रंग से दमकती हुई।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も成長が速い魚の一つ。緑金色に輝く体を持つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록빛 황금색으로 빛나는, 가장 빨리 자라는 물고기 중 하나."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生长最快的鱼类之一，闪耀着金绿色的光泽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生長最快的魚類之一，閃耀著金綠色澤。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أسرع الأسماك نموًّا، تتوهّج بألوان خضراء ذهبية."
          }
        }
      }
    },
