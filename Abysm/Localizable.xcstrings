    "creature.queensnapper.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep-reef snapper with a long forked tail and large eyes for the dim light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pargo de arrecife profundo, con larga cola ahorquillada y ojos grandes para la poca luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vivaneau des récifs profonds, à longue queue fourchue et grands yeux pour la pénombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tiefriff-Schnapper mit langer Gabelflosse und großen Augen für das schwache Licht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lutiano di barriera profonda con lunga coda biforcuta e grandi occhi per la luce fioca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermelho de recife profundo com cauda longa e bifurcada e olhos grandes para a pouca luz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубоководный луциан с длинным раздвоенным хвостом и большими глазами для полумрака."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucjan głębokiej rafy o długim widlastym ogonie i dużych oczach do słabego światła."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een diepterifsnapper met een lange gevorkte staart en grote ogen voor het schemerlicht."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loş ışık için uzun çatallı kuyruklu ve iri gözlü, derin resif mercanıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक गहरी-भित्ति स्नैपर, लंबी दोफँकी पूँछ और मद्धम रोशनी के लिए बड़ी आँखों वाली।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深い岩礁のフエダイ。長い二股の尾と、薄暗さに適した大きな目を持つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 갈라진 꼬리와 어둠에 맞는 큰 눈을 지닌 심해 퉁돔."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖息深礁的笛鲷，长尾深叉，大眼适应昏暗的光线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深礁笛鯛，有長長的叉尾與適應微光的大眼。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نهّاش الشعاب العميقة بذيل طويل مشقوق وعينين كبيرتين للضوء الخافت."
          }
        }
      }
    },
