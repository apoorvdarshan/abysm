    "creature.nautilus.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 'living fossil' that jets through the water inside a spiral shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un \"fósil viviente\" que se propulsa por el agua dentro de una concha en espiral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Fossile vivant » qui se propulse dans l'eau à l'intérieur d'une coquille en spirale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein „lebendes Fossil“, das per Düsenantrieb in einer Spiralschale durchs Wasser schießt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 'fossile vivente' che si propulsa nell'acqua dentro una conchiglia a spirale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 'fóssil vivo' que se impulsiona pela água dentro de uma concha espiral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Живое ископаемое», что мчится сквозь воду в спиральной раковине."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Żywa skamieniałość”, która mknie przez wodę w spiralnej muszli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een 'levend fossiel' dat door het water schiet in een spiraalvormige schelp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarmal kabuğunun içinde suda fırlayarak ilerleyen 'yaşayan bir fosildir'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक 'जीवित जीवाश्म' जो सर्पिल खोल के भीतर पानी में फुहार मारकर आगे बढ़ता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "螺旋の殻に入り、水を噴き出して進む「生きた化石」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나선형 껍데기 속에서 물을 뿜어 나아가는 '살아있는 화석'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种“活化石”，藏在螺旋外壳里喷水推进前行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一種「活化石」，藏在螺旋殼裡噴水穿行。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"أحفورة حية\" تندفع في الماء داخل صدفة حلزونية."
          }
        }
      }
    },
    "creature.sunfish.name": {
