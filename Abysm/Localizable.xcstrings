    "creature.sunfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The heaviest bony fish — it basks on its side to rewarm after deep dives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pez óseo más pesado; toma el sol de costado para recalentarse tras bucear hondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus lourd des poissons osseux — il se chauffe sur le flanc après ses plongées profondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der schwerste Knochenfisch — er sonnt sich seitlich, um nach Tieftauchgängen wieder warm zu werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pesce osseo più pesante; si crogiola di fianco per riscaldarsi dopo le immersioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O maior peixe ósseo — boia de lado para se reaquecer após mergulhos profundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая тяжёлая костистая рыба — греется на боку после глубоких погружений."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najcięższa ryba kostnoszkieletowa — wygrzewa się na boku, by ogrzać się po głębokich nurkowaniach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zwaarste beenvis — hij ligt op zijn zij te zonnen om op te warmen na diepe duiken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ağır kemikli balıktır; derin dalışlardan sonra ısınmak için yan yatarak güneşlenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे भारी अस्थि-मछली — गहरे गोते के बाद फिर गर्म होने को करवट लेकर धूप सेंकती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も重い硬骨魚。深海潜水後は横たわって日光浴し体を温め直す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 무거운 경골어류. 깊은 잠수 후 옆으로 누워 몸을 다시 데운다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最重的硬骨鱼——深潜后会侧躺在水面晒太阳回暖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最重的硬骨魚——深潛後會側身曬太陽以重新回暖。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثقل سمكة عظمية، تستلقي على جنبها لتتدفّأ بعد الغوص العميق."
          }
        }
      }
    },
