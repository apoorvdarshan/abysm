    "creature.oarfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longest bony fish (to 8 m); old 'sea serpent' tales may be sightings of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pez óseo más largo (hasta 8 m); las viejas leyendas de \"serpientes marinas\" pudieron ser él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus long poisson osseux (jusqu'à 8 m) ; les vieilles légendes de serpents de mer pourraient être lui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der längste Knochenfisch (bis 8 m); alte „Seeschlangen“-Sagen sind vielleicht Sichtungen von ihm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pesce osseo più lungo (fino a 8 m); forse l'origine delle leggende sul serpente di mare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O peixe ósseo mais longo (até 8 m); velhos contos de 'serpentes marinhas' podem ser avistamentos dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длиннейшая костистая рыба (до 8 м); старые легенды о «морском змее» — это, видимо, она."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najdłuższa ryba kostna (do 8 m); dawne opowieści o „wężu morskim” to być może spotkania z nim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De langste beenvis (tot 8 m); oude 'zeeslang'-verhalen zijn mogelijk waarnemingen van hem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En uzun kemikli balık (8 m'ye dek); eski 'deniz yılanı' efsaneleri onun görülmesi olabilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे लंबी अस्थि-मछली (8 मी तक); पुरानी 'समुद्री सर्प' की कथाएँ शायद इसी के दर्शन हों।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も長い硬骨魚（8mに達する）。古い「海蛇」伝説の正体かもしれない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 긴 경골어류(최대 8 m). 옛 '바다뱀' 전설은 이 물고기를 본 것일 수 있다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最长的硬骨鱼（可达8米）；古老的“海蛇”传说或许就是对它的目击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最長的硬骨魚（可達 8 m）；古老的「海蛇」傳說或許就是牠。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطول سمكة عظمية (حتى 8 م)؛ ربما كانت أصل حكايات \"أفاعي البحر\" القديمة."
          }
        }
      }
    },
