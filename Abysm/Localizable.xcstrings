    "creature.coelacanth.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Believed extinct for 65 million years — until one was caught in 1938."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creía extinto desde hacía 65 millones de años, hasta que se pescó uno en 1938."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cru éteint depuis 65 millions d'années — jusqu'à ce qu'on en capture un en 1938."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "65 Millionen Jahre für ausgestorben gehalten — bis 1938 einer gefangen wurde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creduto estinto da 65 milioni di anni, finché nel 1938 ne fu pescato uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tido como extinto havia 65 milhões de anos — até que um foi pescado em 1938."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считалась вымершей 65 млн лет — пока одну не поймали в 1938 году."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uważana za wymarłą od 65 milionów lat — aż jedną złowiono w 1938 roku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geloofd 65 miljoen jaar uitgestorven — tot er in 1938 een werd gevangen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "65 milyon yıl nesli tükenmiş sayıldı; ta ki 1938'de biri yakalanana dek."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6.5 करोड़ साल से विलुप्त माना जाता था — फिर 1938 में एक पकड़ा गया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6500万年前に絶滅したとされたが、1938年に一匹が捕獲された。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6500만 년 전 멸종한 줄 알았으나, 1938년에 한 마리가 잡혔다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曾被认为已灭绝6500万年——直到1938年捕获了一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曾被認為已滅絕 6,500 萬年——直到 1938 年捕獲一條。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظُنّت منقرضة منذ 65 مليون سنة، حتى صِيدت إحداها عام 1938."
          }
        }
      }
    },
