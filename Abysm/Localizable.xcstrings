    "creature.snailfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deepest fish ever filmed; its jelly-like body withstands the crushing pressure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pez más profundo jamás filmado; su cuerpo gelatinoso resiste la presión aplastante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poisson le plus profond jamais filmé ; son corps gélatineux résiste à la pression écrasante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der tiefste je gefilmte Fisch; sein gallertartiger Körper widersteht dem erdrückenden Druck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pesce più profondo mai filmato; il corpo gelatinoso resiste alla pressione schiacciante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O peixe mais fundo já filmado; seu corpo gelatinoso resiste à pressão esmagadora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая глубоководная заснятая рыба; её студенистое тело держит давление."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najgłębiej sfilmowana ryba; jej galaretowate ciało wytrzymuje miażdżące ciśnienie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De diepste vis ooit gefilmd; zijn gelei-achtige lijf weerstaat de verpletterende druk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntülenen en derin balık; jölemsi bedeni ezici basınca dayanır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तक फ़िल्माई गई सबसे गहरी मछली; इसका जेली-सा शरीर कुचलते दबाव को झेल लेता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影された最も深い魚。ゼリー状の体が押しつぶす水圧に耐える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영된 가장 깊은 물고기. 젤리 같은 몸으로 짓누르는 압력을 견딘다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迄今拍到的最深的鱼；果冻般的身体能承受巨大的压力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有史以來拍攝到最深的魚；果凍般的身體能承受巨大水壓。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعمق سمكة صُوّرت يومًا؛ يصمد جسدها الهلامي أمام الضغط الساحق."
          }
        }
      }
    },
