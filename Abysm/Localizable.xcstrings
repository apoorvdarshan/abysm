    "creature.megamouth.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rare giant that cruises with its huge mouth open, filtering tiny plankton."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raro gigante que navega con su enorme boca abierta, filtrando plancton diminuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géant rare qui nage la gueule grande ouverte, filtrant le minuscule plancton."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein seltener Riese, der mit weit offenem Maul gleitet und winziges Plankton filtert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raro gigante che nuota con l'enorme bocca aperta filtrando minuscolo plancton."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gigante raro que vagueia de boca aberta, filtrando plâncton minúsculo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редкий гигант, что плывёт с огромной разинутой пастью, отцеживая крошечный планктон."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzadki olbrzym, który płynie z otwartą wielką paszczą, filtrując maleńki plankton."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zeldzame reus die rondzwemt met zijn enorme bek open, kleine plankton filterend."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devasa ağzı açık süzülerek minik planktonları süzen nadir bir devdir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक दुर्लभ दानव जो अपना विशाल मुँह खोले तैरता है, नन्हे प्लवक छानता हुआ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "巨大な口を開けて泳ぎ、小さなプランクトンを濾し取る希少な巨体。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거대한 입을 벌리고 헤엄치며 작은 플랑크톤을 거르는 희귀한 거인."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "罕见的巨兽，张着巨口缓游，滤食微小的浮游生物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "罕見的巨獸，張著大口巡游，濾食微小的浮游生物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملاق نادر يسبح فاغرًا فمه الضخم، يُرشّح العوالق الدقيقة."
          }
        }
      }
    },
    "creature.fangtooth.name": {
