    "creature.emperorpenguin.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dives over 500 m on a single breath — deeper than any other bird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucea más de 500 m con una sola respiración: más hondo que cualquier otra ave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il plonge à plus de 500 m en une seule respiration — plus profond que tout autre oiseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taucht mit einem Atemzug über 500 m tief — tiefer als jeder andere Vogel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si immerge oltre 500 m con un solo respiro: più di ogni altro uccello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergulha mais de 500 m num só fôlego — mais fundo que qualquer outra ave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ныряет глубже 500 м на одном вдохе — глубже любой другой птицы."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nurkuje ponad 500 m na jednym oddechu — głębiej niż jakikolwiek inny ptak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duikt ruim 500 m op één adem — dieper dan elke andere vogel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek nefeste 500 m'nin ötesine dalar; başka hiçbir kuştan daha derine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही साँस में 500 मी से गहरा गोता — किसी भी अन्य पक्षी से गहरा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一息で500m以上潜る、他のどんな鳥よりも深く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨 한 번에 500 m 넘게 잠수한다 — 어떤 새보다 깊다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一口气可下潜500多米——比任何其他鸟类都深。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一口氣能潛超過 500 m——比任何鳥類都深。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغوص أكثر من 500 م بنَفَسٍ واحد، أعمق من أي طائر آخر."
          }
        }
      }
    },
