    "creature.tubeworm.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has no mouth or gut; it lives on bacteria fed by hot vent chemicals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene boca ni intestino; vive de bacterias nutridas por las sustancias de las fumarolas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans bouche ni intestin, il vit de bactéries nourries par les fluides des sources chaudes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat weder Mund noch Darm; er lebt von Bakterien, die sich von heißen Quellchemikalien nähren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza bocca né intestino, vive di batteri nutriti dalle sostanze dei camini idrotermali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tem boca nem intestino; vive de bactérias alimentadas por químicos de fontes quentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без рта и кишечника; живёт за счёт бактерий, что питаются химией горячих источников."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma ust ani jelit; żyje dzięki bakteriom karmionym chemią gorących kominów."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft geen mond of darm; hij leeft van bacteriën gevoed door hete bronchemicaliën."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağzı ya da bağırsağı yoktur; sıcak baca kimyasallarıyla beslenen bakterilerle yaşar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न मुँह है न आँत; यह गर्म छिद्रों के रसायनों से पले बैक्टीरिया पर जीता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口も腸もなく、熱水の化学物質を栄養とする細菌に生かされている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입도 장도 없이, 열수 분출구의 화학물질을 먹는 박테리아에 기대 산다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有口也没有肠胃；靠由热泉化学物质滋养的细菌为生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有嘴也沒有腸；靠熱泉化學物質滋養的細菌維生。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا فم أو أمعاء؛ تعيش على بكتيريا تتغذّى من كيماويات الفوهات الحارّة."
          }
        }
      }
    },
