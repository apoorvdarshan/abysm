    "creature.grenadier.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also called a rattail — one of the most common fish on the deep-sea floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También llamado cola de rata: uno de los peces más comunes del fondo abisal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi appelé queue-de-rat — l'un des poissons les plus communs des grands fonds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Rattenschwanz genannt — einer der häufigsten Fische am Tiefseeboden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Detto anche coda di topo, è uno dei pesci più comuni sui fondali abissali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também chamado de rabo-de-rato — um dos peixes mais comuns do fundo abissal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зовётся также крысохвостом — одна из самых частых рыб на глубоком дне."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwany też szczurzym ogonem — jedna z najpospolitszych ryb dna głębinowego."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook rattenstaart genoemd — een van de meest voorkomende vissen op de diepzeebodem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıçankuyruğu da denir; derin deniz tabanının en yaygın balıklarından biridir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे रैटटेल भी कहते हैं — गहरे-समुद्र तल की सबसे आम मछलियों में से एक।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラットテイルとも呼ばれ、深海底で最も多い魚の一つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쥐꼬리고기라고도 불리며, 심해 바닥에서 가장 흔한 물고기 중 하나."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "又称鼠尾鱼——深海海底最常见的鱼类之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "又稱鼠尾魚——深海海底最常見的魚類之一。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدعى أيضًا ذيل الجرذ، من أكثر الأسماك شيوعًا على قاع الأعماق."
          }
        }
      }
    },
