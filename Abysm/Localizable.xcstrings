    "creature.chaincatshark.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small shark whose chain-pattern skin glows green — it's biofluorescent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tiburón pequeño cuya piel con patrón de cadena brilla en verde: es biofluorescente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit requin dont la peau à motif de chaîne brille en vert — il est biofluorescent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Hai, dessen kettengemusterte Haut grün leuchtet — er ist biofluoreszent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo squalo dalla pelle a catene che brilla di verde: è biofluorescente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno tubarão cuja pele em padrão de corrente brilha em verde — é biofluorescente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькая акула, чья кожа в цепном узоре светится зелёным — она биофлуоресцентна."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały rekin, którego łańcuszkowy wzór skóry świeci na zielono — jest biofluorescencyjny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kleine haai waarvan de huid met kettingpatroon groen oplicht — hij is biofluorescent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zincir desenli derisi yeşil parlayan küçük bir köpekbalığıdır; biyofloresandır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटी शार्क जिसकी ज़ंजीर-नुमा त्वचा हरी चमकती है — यह जैव-प्रतिदीप्त है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖模様の肌が緑に光る小さなサメ。生物蛍光を放つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사슬 무늬 피부가 초록빛으로 빛나는 작은 상어 — 생체형광을 낸다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种小型鲨鱼，链状斑纹的皮肤会发出绿光——它具有生物荧光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小型鯊魚，鏈狀花紋的皮膚會發出綠光——具生物螢光。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرش صغير يتوهّج جلده ذو نقش السلاسل باللون الأخضر، فهو حيوي الإضاءة."
          }
        }
      }
    },
