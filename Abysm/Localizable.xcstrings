    "creature.stripedbass.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prized coastal fish that migrates along the shore in big schools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preciado pez costero que migra a lo largo de la orilla en grandes bancos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poisson côtier prisé qui migre le long du rivage en grands bancs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein geschätzter Küstenfisch, der in großen Schwärmen entlang der Küste wandert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pregiato pesce costiero che migra lungo la riva in grandi banchi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peixe costeiro valorizado que migra ao longo da costa em grandes cardumes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ценная прибрежная рыба, что мигрирует вдоль берега большими косяками."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceniona ryba przybrzeżna, która wędruje wzdłuż brzegu w wielkich ławicach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gewilde kustvis die in grote scholen langs de kust trekt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıyı boyunca büyük sürüler halinde göç eden, kıymetli bir kıyı balığıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बेशकीमती तटीय मछली जो बड़े झुंडों में तट के साथ प्रवास करती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな群れで沿岸を回遊する、人気の高い沿岸魚。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 무리를 지어 해안을 따라 이동하는 귀한 연안 물고기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "珍贵的近岸鱼类，成大群沿海岸迁徙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "珍貴的沿岸魚種，成大群沿著海岸遷徙。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمكة ساحلية نفيسة تهاجر على طول الشاطئ في أسراب كبيرة."
          }
        }
      }
    },
