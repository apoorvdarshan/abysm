    "creature.bullshark.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can survive in fresh water and has swum far up rivers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive en agua dulce y ha remontado ríos muy adentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il survit en eau douce et a remonté très loin les cours d'eau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann in Süßwasser überleben und ist weit flussaufwärts geschwommen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopravvive in acqua dolce e ha risalito i fiumi per lunghi tratti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive em água doce e já nadou rio acima por grandes distâncias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выживает в пресной воде и заплывает далеко вверх по рекам."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrafi przetrwać w słodkiej wodzie i zapływa daleko w górę rzek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan in zoet water overleven en is ver de rivieren op gezwommen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatlı suda hayatta kalabilir ve nehirlerin çok yukarısına kadar yüzmüştür."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीठे पानी में भी जीवित रह सकती है और नदियों में बहुत ऊपर तक तैर चुकी है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "淡水でも生きられ、川をはるか上流まで泳いだ記録もある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민물에서도 살 수 있어 강을 거슬러 멀리까지 올라간 적이 있다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能在淡水中存活，曾沿河逆流游向内陆很远。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能在淡水中存活，曾溯游進入河流深處。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيش في المياه العذبة وقد سبح بعيدًا صعودًا في الأنهار."
          }
        }
      }
    },
