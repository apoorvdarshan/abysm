    "creature.dragonfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes red light that it alone can see — a hidden hunting beam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emite una luz roja que solo él puede ver: un foco de caza oculto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il produit une lumière rouge que lui seul perçoit — un faisceau de chasse invisible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugt rotes Licht, das nur er sehen kann — ein verborgener Jagdstrahl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Produce una luce rossa che solo lui può vedere: un faro di caccia nascosto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emite uma luz vermelha que só ele enxerga — um facho de caça oculto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Излучает красный свет, видимый лишь ей самой — скрытый охотничий луч."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytwarza czerwone światło, które tylko on widzi — ukryty promień myśliwski."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt rood licht dat alleen hijzelf kan zien — een verborgen jachtbundel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kendisinin görebildiği kırmızı ışık üretir; gizli bir av huzmesi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाल रोशनी बनाती है जो केवल यही देख सकती है — एक छिपी शिकार-किरण।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分だけが見える赤い光を放つ、隠れた狩りのビーム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오직 자신만 볼 수 있는 붉은 빛을 낸다 — 숨겨진 사냥용 광선."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能发出只有自己看得见的红光——一束隐形的捕猎光束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能發出只有自己看得見的紅光——一道隱形的狩獵光束。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُصدر ضوءًا أحمر تراه وحدها، شعاع صيد خفيّ."
          }
        }
      }
    },
