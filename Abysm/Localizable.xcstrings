    "creature.manatee.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle 'sea cow' that grazes seagrass and surfaces every few minutes to breathe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dócil \"vaca marina\" que pasta praderas de algas y sube a respirar cada pocos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doux « bœuf de mer » qui broute les herbiers et remonte respirer toutes les quelques minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte „Seekuh“, die Seegras grast und alle paar Minuten zum Atmen auftaucht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mite 'vacca marina' che bruca fanerogame e risale a respirare ogni pochi minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma 'vaca-marinha' mansa que pasta capim e sobe a cada poucos minutos para respirar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кроткая «морская корова», что щиплет водоросли и каждые несколько минут всплывает подышать."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łagodna „morska krowa”, która skubie trawę morską i co kilka minut wynurza się, by oddychać."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachtaardige 'zeekoe' die zeegras graast en elke paar minuten boven komt om adem te halen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deniz çayırı otlayan ve birkaç dakikada bir nefes almak için yüzeye çıkan uysal bir devdir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सौम्य 'समुद्री गाय' जो समुद्री घास चरती है और साँस के लिए हर कुछ मिनट में ऊपर आती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海草を食む穏やかな「海牛」。数分おきに息継ぎに浮上する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해초를 뜯어 먹는 온순한 '바다소'로, 몇 분마다 수면에 올라 숨을 쉰다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温和的“海中之牛”，以海草为食，每隔几分钟便浮出水面呼吸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫和的「海中乳牛」，以海草為食，每隔幾分鐘浮上換氣。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"بقرة بحر\" وديعة ترعى الأعشاب البحرية وتطفو كل بضع دقائق لتتنفّس."
          }
        }
      }
    },
