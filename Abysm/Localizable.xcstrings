    "creature.orca.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ocean's top predator; pods hunt as a team and speak their own dialects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gran depredador del océano; los grupos cazan en equipo y hablan sus propios dialectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le superprédateur de l'océan ; les groupes chassent en équipe et parlent leurs propres dialectes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spitzenräuber des Meeres; Schoten jagen im Team und sprechen eigene Dialekte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il predatore al vertice dell'oceano; i branchi cacciano in squadra e parlano dialetti propri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O predador supremo do oceano; bandos caçam em equipe e têm dialetos próprios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высший хищник океана; стаи охотятся сообща и говорят на своих диалектах."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyższy drapieżnik oceanu; stada polują zespołowo i mówią własnymi dialektami."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toproofdier van de oceaan; groepen jagen als team en spreken eigen dialecten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okyanusun en tepe avcısı; sürüler takım halinde avlanır ve kendi lehçelerinde konuşur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समुद्र का शीर्ष शिकारी; झुंड मिलकर शिकार करते हैं और अपनी अलग बोलियाँ बोलते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海の頂点捕食者。群れで連携して狩り、独自の方言を話す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바다 최상위 포식자. 무리지어 협력 사냥하며 저마다의 방언으로 소통한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海洋的顶级掠食者；群体协作捕猎，各群还有自己的“方言”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海洋的頂級掠食者；族群團隊狩獵，並擁有自己的方言。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعتى مفترسات المحيط؛ تصطاد جماعاتها معًا وتتحدث بلهجاتها الخاصة."
          }
        }
      }
    },
