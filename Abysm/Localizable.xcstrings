    "creature.vampiresquid.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No vampire — it eats 'marine snow' and turns inside-out to hide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es vampiro: come \"nieve marina\" y se voltea del revés para esconderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas un vampire — il mange la « neige marine » et se retourne pour se cacher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Vampir — er frisst „Meeresschnee“ und stülpt sich zum Verstecken um."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente vampiro: mangia 'neve marina' e si rovescia per nascondersi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de vampira — come 'neve marinha' e se vira do avesso para se esconder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакой не вампир — ест «морской снег» и выворачивается наизнанку, чтобы спрятаться."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden wampir — żywi się „morskim śniegiem” i wywija się na lewą stronę, by się ukryć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vampier — hij eet 'mariene sneeuw' en keert zich binnenstebuiten om te verschuilen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vampir değildir; 'deniz karı' yer ve saklanmak için tersyüz olur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई पिशाच नहीं — यह 'समुद्री बर्फ़' खाती है और छिपने को उलट जाती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸血鬼ではなく「マリンスノー」を食べ、裏返って身を隠す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흡혈은커녕 '바다눈'을 먹고, 몸을 뒤집어 숨는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并非吸血——它以“海雪”为食，遇险时会把身体翻转藏身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "並非吸血鬼——牠吃「海洋雪」，遇危時翻轉身體藏起來。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس مصّاصًا للدماء؛ يأكل \"ثلج البحر\" وينقلب من الداخل ليختبئ."
          }
        }
      }
    },
