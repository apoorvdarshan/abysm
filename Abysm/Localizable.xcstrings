    "zone.abyss.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigid, pitch-black plains under immense pressure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llanuras gélidas y oscurísimas bajo una presión inmensa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaines glaciales et noires sous une pression immense."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiskalte, stockfinstere Ebenen unter gewaltigem Druck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianure gelide e nere come la pece sotto una pressione immensa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planícies gélidas e escuras sob pressão imensa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Студёные кромешные равнины под колоссальным давлением."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lodowate, czarne równiny pod ogromnym ciśnieniem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "IJzige, pikzwarte vlakten onder enorme druk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buz gibi, zifirî karanlık, devasa basınç altındaki ovalar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बर्फीले, घुप्प अँधेरे मैदान, अपार दबाव के नीचे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "極寒で漆黒の平原。とてつもない水圧がのしかかる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혹한의 칠흑 같은 평원, 엄청난 압력이 짓누른다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酷寒、漆黑的平原，承受着巨大的水压。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "酷寒漆黑的平原，承受著巨大的水壓。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سهولٌ شديدة البرودة حالكة السواد تحت ضغطٍ هائل."
          }
        }
      }
    },
    "zone.hadal.name": {
      "extractionState": "manual",
      "localizations": {
