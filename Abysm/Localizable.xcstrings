    "creature.seapig.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plump pink sea cucumber that walks the abyssal mud on tube-foot 'legs'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rechoncho pepino de mar rosado que camina por el fango abisal sobre \"patas\" tubulares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concombre de mer rose et dodu qui arpente la vase abyssale sur des « pattes » à podia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pummelige rosa Seegurke, die auf Füßchen-„Beinen“ durch den Tiefseeschlamm läuft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paffuto cetriolo di mare rosa che cammina sul fango abissale su 'zampe' a piedi ambulacrali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pepino-do-mar rosado e roliço que anda na lama abissal com 'pernas' de pés-ambulacrais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пухлый розовый голотурий, что бродит по абиссальному илу на ножках-амбулакрах."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulchny, różowy ogórek morski, który kroczy po abisalnym mule na nóżkach z nibynóżek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een mollige roze zeekomkommer die over de abyssale modder loopt op 'pootjes' van buisvoetjes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüp ayak 'bacaklarıyla' derin deniz çamurunda yürüyen tombul, pembe bir deniz hıyarıdır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक गोल-मटोल गुलाबी समुद्री ककड़ी जो नली-पैरों पर रसातल की कीचड़ में चलती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふっくらピンクのナマコ。管足の「脚」で深海の泥の上を歩く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통통한 분홍빛 해삼으로, 관족 '다리'로 심해 진흙 위를 걷는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆胖的粉色海参，靠管足般的“腿”在深海泥地上行走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓胖粉嫩的海參，用管足「腿」在深淵泥地上行走。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيار بحر وردي ممتلئ يمشي في وحل اللجّة على \"أرجل\" أنبوبية."
          }
        }
      }
    },
