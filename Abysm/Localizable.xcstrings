    "zone.twilight.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fading blue gloom — cold, dim, lit by living glow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Penumbra azul que se apaga: fría, tenue, iluminada por luz viva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pénombre bleue déclinante — froide, sombre, éclairée par le vivant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verblassendes blaues Düster — kalt, trüb, von lebendem Leuchten erhellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Penombra blu che svanisce: fredda, fioca, rischiarata da bagliori viventi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Penumbra azul que se desvanece — fria, escura, iluminada por brilho vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаснущий синий полумрак — холодный, тусклый, освещённый живым свечением."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasnący błękitny mrok — zimny, ciemny, rozświetlany żywym blaskiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervagend blauw duister — koud, schemerig, verlicht door levend licht."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solan mavi karanlık: soğuk, loş, canlı ışıltıyla aydınlanır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धुंधलाता नीला अँधेरा — ठंडा, मद्धम, जीवों की चमक से रोशन।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青い光が薄れる冷たく暗い世界。生き物の光が灯る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옅어지는 푸른 어스름 — 차갑고 어둑하며, 생물의 빛이 밝히는 곳."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渐暗的蓝色幽光——寒冷、昏暗，靠生物之光点亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漸暗的幽藍——寒冷昏暗，靠生物的光點亮。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زرقةٌ خافتة تتلاشى، باردة معتمة يضيئها التوهّج الحيّ."
          }
        }
      }
    },
    "zone.midnight.name": {
