    "creature.brittlestar.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A starfish relative that crawls on writhing arms it can regrow if it loses one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pariente de la estrella de mar que se arrastra con brazos retorcidos y regenera los que pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cousine de l'étoile de mer, elle rampe sur des bras ondulants qu'elle peut régénérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Seestern-Verwandter, der auf sich windenden Armen kriecht, die er bei Verlust nachwachsen lässt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parente delle stelle marine, striscia su braccia guizzanti che può rigenerare se le perde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parente da estrela-do-mar que rasteja com braços ondulantes e regenera os que perde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Родич морской звезды, что ползёт на извивающихся лучах и отращивает потерянный."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krewny rozgwiazdy, który pełza na wijących się ramionach i odtwarza je po utracie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verwant van de zeester die kruipt op kronkelende armen die hij kan hergroeien als hij er een verliest."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denizyıldızı akrabasıdır; kıvranan kollarıyla yürür ve kaybettiği kolu yeniden üretebilir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारामछली का रिश्तेदार जो लहराती भुजाओं पर रेंगता है और टूटी भुजा फिर उगा लेता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒトデの仲間。くねる腕で這い、失っても腕を再生できる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈틀거리는 팔로 기어 다니며, 잃은 팔은 다시 자라는 불가사리의 친척."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海星的亲戚，靠扭动的腕足爬行，断腕后还能再生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海星的近親，靠扭動的腕足爬行，斷腕後還能再生。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قريب لنجم البحر يزحف على أذرع متلوّية يعيد إنباتها إن فقد إحداها."
          }
        }
      }
    },
