    "creature.fireflysquid.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers its body in tiny blue lights to lure prey and dazzle predators."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre su cuerpo de diminutas luces azules para atraer presas y deslumbrar depredadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il couvre son corps de minuscules lumières bleues pour attirer ses proies et éblouir les prédateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überzieht seinen Körper mit winzigen blauen Lichtern, um Beute zu locken und Räuber zu blenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si copre di minuscole luci blu per attirare le prede e abbagliare i predatori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobre o corpo de pequenas luzes azuis para atrair presas e ofuscar predadores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрывает тело крошечными синими огнями, чтобы манить добычу и слепить хищников."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrywa ciało maleńkimi niebieskimi światełkami, by wabić zdobycz i oślepiać drapieżniki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedekt zijn lijf met kleine blauwe lichtjes om prooi te lokken en roofdieren te verblinden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avı çekmek ve avcıların gözünü kamaştırmak için bedenini minik mavi ışıklarla kaplar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शिकार लुभाने और शिकारियों को चकाचौंध करने के लिए अपने शरीर को नन्ही नीली रोशनियों से ढक लेती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体を青い光で覆い、獲物を誘い捕食者を眩ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 푸른 빛으로 온몸을 덮어 먹이를 꾀고 포식자를 현혹한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全身布满微小的蓝色发光点，用以诱捕猎物、迷惑天敌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全身佈滿藍色微光，用來誘捕獵物並迷惑天敵。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكسو جسده بأضواء زرقاء دقيقة ليُغري الفريسة ويُبهر المفترسات."
          }
        }
      }
    },
