    "creature.colossalsquid.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has the largest eyes of any animal — about the size of dinner plates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene los ojos más grandes de todos los animales, del tamaño de platos llanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a les plus grands yeux du règne animal — environ la taille d'assiettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat die größten Augen aller Tiere — etwa so groß wie Essteller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha gli occhi più grandi di qualsiasi animale, grandi come piatti da portata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem os maiores olhos de qualquer animal — quase do tamanho de pratos de jantar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У него самые большие глаза среди всех животных — размером с обеденную тарелку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma największe oczy ze wszystkich zwierząt — niemal wielkości talerzy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft de grootste ogen van elk dier — ongeveer zo groot als dinerborden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm hayvanlar içinde en büyük gözlere sahiptir; aşağı yukarı yemek tabağı kadar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी जानवर की सबसे बड़ी आँखें — लगभग खाने की थाली जितनी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらゆる動物で最大の目を持つ。大皿ほどの大きさだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 동물 중 가장 큰 눈을 지녔다 — 거의 접시만 한 크기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拥有动物界最大的眼睛——约有餐盘那么大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有所有動物中最大的眼睛——約有餐盤那麼大。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "له أكبر عينين بين كل الحيوانات، بحجم أطباق الطعام تقريبًا."
          }
        }
      }
    },
