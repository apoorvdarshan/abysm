    "creature.scalyfoot.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Armours its foot and shell with iron — the only animal known to do so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinda su pie y concha con hierro: el único animal conocido que lo hace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blinde son pied et sa coquille de fer — le seul animal connu à le faire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Panzert Fuß und Schale mit Eisen — das einzige Tier, das dies bekanntermaßen tut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corazza piede e guscio con il ferro: l'unico animale noto a farlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinda o pé e a concha com ferro — o único animal que se sabe fazer isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бронирует ногу и раковину железом — единственное животное, что так умеет."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opancerza nogę i muszlę żelazem — jako jedyne znane zwierzę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantsert zijn voet en schelp met ijzer — het enige dier waarvan dit bekend is."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayağını ve kabuğunu demirle zırhlar; bunu yaptığı bilinen tek hayvandır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पैर और खोल पर लोहे का कवच चढ़ाता है — ऐसा करने वाला एकमात्र ज्ञात जीव।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足と殻を鉄で武装する、それを行う唯一の動物として知られる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발과 껍데기를 철로 무장한다 — 그렇게 하는 유일한 동물."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用铁为足和壳披甲——已知唯一会这么做的动物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用鐵質為足部和殼裝甲——已知唯一會這麼做的動物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدرّع قدمه وصدفته بالحديد، الحيوان الوحيد المعروف بفعل ذلك."
          }
        }
      }
    },
