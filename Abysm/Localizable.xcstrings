    "creature.cuskeel.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Among the deepest of all fishes ever caught."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre los peces más profundos jamás capturados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmi les poissons les plus profonds jamais capturés."
          }
        },
        "de": {
