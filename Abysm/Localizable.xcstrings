    "creature.orangeroughy.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can live around 250 years, one of the longest-lived fish known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede vivir unos 250 años, uno de los peces más longevos que se conocen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut vivre environ 250 ans, l'un des poissons les plus longévifs connus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann rund 250 Jahre alt werden, einer der langlebigsten bekannten Fische."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può vivere circa 250 anni, uno dei pesci più longevi conosciuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode viver cerca de 250 anos, um dos peixes mais longevos conhecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может жить около 250 лет — одна из самых долгоживущих известных рыб."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może żyć około 250 lat, to jedna z najdłużej żyjących znanych ryb."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ongeveer 250 jaar leven, een van de langstlevende bekende vissen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık 250 yıl yaşayabilir; bilinen en uzun ömürlü balıklardan biri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग 250 साल तक जी सकती है, ज्ञात सबसे लंबा जीने वाली मछलियों में से एक।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約250年生きることもある、知られる限り最も長寿の魚の一つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 250년을 살 수 있는, 알려진 가장 오래 사는 물고기 중 하나."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可活约250年，是已知寿命最长的鱼类之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壽命可達約 250 年，是已知最長壽的魚類之一。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تعيش نحو 250 عامًا، من أطول الأسماك المعروفة عمرًا."
          }
        }
      }
    },
