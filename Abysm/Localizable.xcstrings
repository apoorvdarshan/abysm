    "creature.bigeyetuna.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spends the day in cold deep water and warms up near the surface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el día en aguas frías y profundas y se calienta cerca de la superficie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passe la journée dans l'eau froide des profondeurs et se réchauffe près de la surface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringt den Tag im kalten Tiefenwasser und wärmt sich nahe der Oberfläche auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa il giorno nelle acque fredde profonde e si riscalda vicino alla superficie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa o dia na água fria das profundezas e se aquece perto da superfície."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Днём держится в холодной глубине, а у поверхности согревается."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień spędza w zimnej głębinie, a ogrzewa się przy powierzchni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brengt de dag door in koud diep water en warmt op nabij het oppervlak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündüzleri soğuk derin suda geçirir ve yüzeyde ısınır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन ठंडे गहरे पानी में बिताती है और सतह के पास आकर गर्म हो जाती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昼は冷たい深海で過ごし、表層近くで体を温める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮에는 차가운 심해에서 지내고 수면 가까이에서 몸을 데운다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白天待在寒冷的深水，靠近水面取暖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白天待在寒冷的深水，再浮近水面取暖。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقضي النهار في الأعماق الباردة وتتدفّأ قرب السطح."
          }
        }
      }
    },
