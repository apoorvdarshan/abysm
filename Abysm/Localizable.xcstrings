    "creature.cosmicjelly.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep-sea jelly with glowing organs, filmed over the abyssal plain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medusa abisal de órganos luminosos, filmada sobre la llanura abisal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Méduse des abysses aux organes lumineux, filmée au-dessus de la plaine abyssale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tiefseequalle mit leuchtenden Organen, gefilmt über der Tiefseeebene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medusa abissale dagli organi luminosi, filmata sopra la piana abissale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Água-viva abissal com órgãos luminosos, filmada sobre a planície abissal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубоководная медуза со светящимися органами, заснятая над абиссальной равниной."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głębinowa meduza ze świecącymi narządami, sfilmowana nad równiną abisalną."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een diepzeekwal met gloeiende organen, gefilmd boven de abyssale vlakte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlayan organları olan, derin deniz ovası üzerinde görüntülenen bir denizanası."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चमकते अंगों वाली एक गहरे-समुद्री जेली, रसातल मैदान के ऊपर फ़िल्माई गई।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光る器官を持つ深海のクラゲ。深海平原の上で撮影された。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛나는 기관을 지닌 심해 해파리로, 심해 평원 위에서 촬영되었다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种长着发光器官的深海水母，曾在深海平原上空被拍到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一種有發光器官的深海水母，曾在深淵平原上被拍攝到。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قنديل أعماقي بأعضاء متوهّجة، صُوّر فوق سهل اللجّة."
          }
        }
      }
    },
