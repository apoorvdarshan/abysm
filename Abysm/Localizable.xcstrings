    "landmark.deepest_fish.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A snailfish at 8,336 m — near the limit life can survive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pez caracol a 8.336 m: cerca del límite donde la vida puede sobrevivir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un liparis à 8 336 m — proche de la limite où la vie peut survivre."
          }
        },
        "de": {
