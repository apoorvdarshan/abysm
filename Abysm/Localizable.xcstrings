    "creature.yeticrab.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Farms bacteria on its furry arms beside hydrothermal vents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva bacterias en sus brazos peludos junto a las fuentes hidrotermales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cultive des bactéries sur ses bras velus près des sources hydrothermales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Züchtet Bakterien auf ihren pelzigen Armen neben hydrothermalen Quellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coltiva batteri sulle chele pelose accanto ai camini idrotermali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva bactérias nos braços peludos junto a fontes hidrotermais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выращивает бактерий на мохнатых лапах у гидротермальных источников."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoduje bakterie na owłosionych ramionach przy kominach hydrotermalnych."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kweekt bacteriën op zijn harige armen naast hydrothermale bronnen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidrotermal bacaların yanında, tüylü kollarında bakteri yetiştirir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जलतापीय छिद्रों के पास अपनी रोएँदार भुजाओं पर बैक्टीरिया उगाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熱水噴出孔のそばで、毛深い腕に細菌を育てて食べる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열수 분출구 곁에서 털 난 팔에 박테리아를 길러 먹는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在热液喷口旁，于多毛的螯肢上养殖细菌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在熱泉旁的毛茸茸臂上栽培細菌為食。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزرع البكتيريا على ذراعيه الكثيفتي الشَّعر بجوار الفوهات الحرارية المائية."
          }
        }
      }
    },
