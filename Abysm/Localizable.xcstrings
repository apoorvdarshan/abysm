          }
        }
      }
    },
    "zone.midnight.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eternal black, near-freezing, crushing dark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Negrura eterna, casi helada, oscuridad aplastante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noir éternel, presque glacé, ténèbres écrasantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ewiges Schwarz, fast eisig, erdrückende Finsternis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Buio eterno, quasi gelido, tenebre opprimenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuridão eterna, quase congelante, trevas esmagadoras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечная чернота, почти ледяная, давящая тьма."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczna czerń, niemal lodowata, miażdżący mrok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eeuwig zwart, bijna vrieskoud, verpletterend donker."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuz karanlık, donma noktasında, ezici zifirî siyahlık."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनंत कालापन, लगभग हिमांक पर, कुचलता हुआ अँधेरा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠の闇。凍えるほど冷たく、押しつぶす暗黒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원한 암흑, 얼어붙을 듯 차갑고 짓누르는 어둠."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永恒的漆黑，近乎冰点，令人窒息的黑暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永恆的黑暗，近乎冰點，壓迫的漆黑。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوادٌ أبدي، شبه متجمّد، وظلامٌ ساحق."
          }
        }
      }
    },
    "zone.abyss.name": {
      "extractionState": "manual",
