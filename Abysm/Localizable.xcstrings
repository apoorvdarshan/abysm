    "landmark.challenger_deep.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bottom of the ocean. You made it all the way down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo del océano. Has llegado hasta lo más hondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fond de l'océan. Vous êtes descendu jusqu'au bout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Grund des Ozeans. Du hast es ganz nach unten geschafft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fondo dell'oceano. Sei arrivato fino in fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo do oceano. Você chegou até lá embaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дно океана. Вы спустились до самого низа."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dno oceanu. Dotarłeś aż na sam dół."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bodem van de oceaan. Je hebt het helemaal tot beneden gehaald."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okyanusun dibi. Ta en aşağıya kadar indin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समुद्र की तलहटी। आप एकदम नीचे तक पहुँच गए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海の最深部。とうとう一番下まで到達した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바다의 밑바닥. 당신은 끝까지 내려왔다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海洋的底部。你一路抵达了这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海洋的底部。你一路潛到了最深處。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاع المحيط. لقد وصلت إلى الأسفل تمامًا."
          }
        }
      }
    },
