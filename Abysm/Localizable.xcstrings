    "creature.lanternfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maybe the most abundant vertebrate on Earth, glowing with rows of light organs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quizá el vertebrado más abundante de la Tierra, brillante con hileras de órganos luminosos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut-être le vertébré le plus abondant sur Terre, luisant de rangées d'organes lumineux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht das häufigste Wirbeltier der Erde, leuchtend mit Reihen von Leuchtorganen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forse il vertebrato più abbondante sulla Terra, brilla con file di organi luminosi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez o vertebrado mais abundante da Terra, brilhando com fileiras de órgãos luminosos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, самое многочисленное позвоночное на Земле, сияет рядами органов свечения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Być może najliczniejszy kręgowiec na Ziemi, świecący rzędami narządów świetlnych."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Misschien het talrijkste gewervelde op aarde, gloeiend met rijen lichtorganen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belki Dünya'nın en bol omurgalısıdır; sıra sıra ışık organlarıyla parlar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद धरती का सबसे बहुसंख्यक कशेरुकी, प्रकाश-अंगों की कतारों से चमकती हुई।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球で最も数の多い脊椎動物かもしれず、列をなす発光器で光る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄지어 늘어선 발광 기관으로 빛나며, 지구상 가장 흔한 척추동물일지도 모른다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或许是地球上数量最多的脊椎动物，体侧排列着成行的发光器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或許是地球上數量最多的脊椎動物，身上成排的發光器閃爍。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما أكثر الفقاريات وفرة على الأرض، تتوهّج بصفوف من أعضاء الضوء."
          }
        }
      }
    },
