    "creature.polarbear.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The largest land carnivore — and a strong swimmer that hunts seals at the ice edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mayor carnívoro terrestre, y buen nadador que caza focas en el borde del hielo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus grand carnivore terrestre — bon nageur, il chasse les phoques au bord de la banquise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das größte Landraubtier — und ein starker Schwimmer, der Robben am Eisrand jagt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il più grande carnivoro terrestre, e un forte nuotatore che caccia foche ai bordi del ghiaccio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O maior carnívoro terrestre — e bom nadador que caça focas na borda do gelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупнейший сухопутный хищник — и сильный пловец, что охотится на тюленей у кромки льда."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największy lądowy drapieżnik — i świetny pływak, który poluje na foki przy krawędzi lodu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het grootste landroofdier — en een sterke zwemmer die zeehonden bejaagt aan de ijsrand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En büyük karasal etçil; aynı zamanda buz kenarında fok avlayan güçlü bir yüzücüdür."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे बड़ा थलीय माँसाहारी — और एक मज़बूत तैराक जो बर्फ़ के किनारे सील का शिकार करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "陸上最大の肉食獣。氷の縁でアザラシを狩る泳ぎの名手でもある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 육상 육식동물이자, 빙붕 가장자리에서 바다표범을 사냥하는 뛰어난 수영가."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陆地上最大的食肉动物——也是泳技高超的猎手，在冰缘捕食海豹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大的陸上食肉動物——也是游泳健將，在冰緣獵捕海豹。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكبر آكلات اللحوم البرية، وسبّاح ماهر يصطاد الفقمات عند حافة الجليد."
          }
        }
      }
    },
