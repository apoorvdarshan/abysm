            "value": "Entre os peixes mais fundos já capturados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди самых глубоководных из всех когда-либо пойманных рыб."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wśród najgłębiej kiedykolwiek złowionych ryb."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoort tot de diepst gevangen vissen ooit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye dek yakalanan en derin balıklar arasındadır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तक पकड़ी गई सबसे गहरी मछलियों में से एक।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまで捕獲された全魚類の中でも最も深く棲むものの一つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 잡힌 가장 깊은 곳의 물고기 중 하나."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曾被捕获的所有鱼类中栖息最深的之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕獲紀錄中棲息最深的魚類之一。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أعمق كل الأسماك التي صِيدت يومًا."
          }
        }
      }
    },
