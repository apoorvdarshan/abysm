    "creature.viperfish.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fangs so long they don't fit inside its mouth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colmillos tan largos que no le caben dentro de la boca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des crocs si longs qu'ils ne rentrent pas dans sa bouche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fänge so lang, dass sie nicht in sein Maul passen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanne così lunghe da non entrare nella sua stessa bocca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Presas tão longas que não cabem dentro da boca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клыки так длинны, что не помещаются в её рту."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kły tak długie, że nie mieszczą się w jego paszczy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanden zo lang dat ze niet in zijn bek passen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dişleri o kadar uzundur ki ağzına sığmaz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतने लंबे नुकीले दाँत कि वे इसके मुँह में समाते ही नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "牙が長すぎて、口の中に収まらないほど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "송곳니가 너무 길어 입 안에 다 들어가지 않는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "獠牙长到连嘴都合不上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獠牙長到嘴裡都裝不下。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنيابها طويلة جدًّا حتى لا تتّسع داخل فمها."
          }
        }
      }
    },
