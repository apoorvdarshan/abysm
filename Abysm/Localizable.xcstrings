    "creature.cockatoosquid.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A glassy, transparent squid that can flush with reddish pigment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un calamar vítreo y transparente que puede teñirse de pigmento rojizo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmar vitreux et transparent qui peut s'empourprer de pigment rougeâtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gläserner, durchsichtiger Kalmar, der sich mit rötlichem Pigment färben kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un calamaro vitreo e trasparente che può tingersi di pigmento rossastro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma lula vítrea e transparente que pode se tingir de pigmento avermelhado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стеклянный прозрачный кальмар, способный налиться красноватым пигментом."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szklista, przezroczysta kałamarnica, która potrafi zaczerwienić się pigmentem."
