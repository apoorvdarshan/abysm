    "creature.dumbooctopus.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaps ear-like fins to 'fly' through the deep — the deepest-living octopus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aletea con sus aletas de oreja para \"volar\" por el abismo: el pulpo que vive más hondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle bat des nageoires en forme d'oreilles pour « voler » dans l'abysse — la pieuvre des plus grands fonds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt mit ohrartigen Flossen, um durch die Tiefe zu „fliegen“ — der tiefstlebende Krake."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbatte pinne a orecchio per 'volare' nel profondo: il polpo che vive più in fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate nadadeiras feito orelhas para 'voar' nas profundezas — o polvo que vive mais fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машет ушеподобными плавниками, «летая» в глубине — самый глубоководный осьминог."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Macha uszatymi płetwami, by „latać” w głębinie — najgłębiej żyjąca ośmiornica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wappert met oorachtige vinnen om door de diepte te 'vliegen' — de diepst levende octopus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulak benzeri yüzgeçlerini çırparak derinlerde 'uçar'; en derinde yaşayan ahtapot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कान-नुमा पंख फड़फड़ाकर गहराई में 'उड़ता' है — सबसे गहरे रहने वाला ऑक्टोपस।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "耳のようなヒレを羽ばたかせ深海を「飛ぶ」、最も深く棲むタコ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀 같은 지느러미를 펄럭여 심해를 '난다' — 가장 깊은 곳에 사는 문어."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍动耳状的鳍在深海中“飞行”——栖息最深的章鱼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍動耳狀鰭在深海「飛行」——棲息最深的章魚。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفرف بزعانف كالأذنين \"ليطير\" في الأعماق، وهو أعمق الأخطبوطات سكنًا."
          }
        }
      }
    },
