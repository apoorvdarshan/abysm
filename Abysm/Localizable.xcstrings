    "landmark.deepest_scuba.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014 — as deep as a human has ever scuba-dived."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014: lo más hondo que un humano ha buceado con botella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014 — la plongée en scaphandre la plus profonde jamais réalisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014 — so tief, wie je ein Mensch mit Gerät getaucht ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014: la massima profondità mai raggiunta in immersione con autorespiratore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014 — o mergulho autônomo mais profundo já feito por um humano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ахмед Габр, 2014 — предельная глубина для аквалангиста."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014 — najgłębiej, jak człowiek kiedykolwiek zanurkował z akwalungiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014 — zo diep als een mens ooit met scuba dook."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014; bir insanın tüple yaptığı en derin dalış."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr, 2014 — किसी इंसान का अब तक का सबसे गहरा स्कूबा गोता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーメッド・ガブル、2014年。人類がスキューバで潜った最深記録。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아메드 가브르, 2014년 — 인간이 스쿠버로 잠수한 가장 깊은 기록."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "艾哈迈德·加布尔，2014年——人类水肺潜水的最深纪录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahmed Gabr，2014 年——人類水肺潛水達到的最深紀錄。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحمد جابر، 2014، أعمق ما غاص إنسان بأسطوانة هواء."
          }
        }
      }
    },
