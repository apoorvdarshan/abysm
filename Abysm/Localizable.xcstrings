    "creature.zombieworm.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bores into whale bones on the seafloor and eats them — it has no mouth or gut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfora los huesos de ballena del fondo y los devora: no tiene boca ni intestino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fore les os de baleine au fond et les dévore — sans bouche ni intestin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bohrt sich in Walknochen am Meeresgrund und frisst sie — er hat weder Mund noch Darm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scava nelle ossa di balena sul fondale e le divora: non ha né bocca né intestino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfura ossos de baleia no fundo do mar e os devora — não tem boca nem intestino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вгрызается в китовые кости на дне и ест их — у него нет ни рта, ни кишечника."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wwierca się w kości wielorybów na dnie i je zjada — nie ma ust ani jelit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boort zich in walvisbotten op de zeebodem en eet ze op — hij heeft geen mond of darm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deniz tabanındaki balina kemiklerini delip yer; ağzı ya da bağırsağı yoktur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समुद्रतल पर व्हेल की हड्डियों में छेद कर उन्हें खाता है — इसका न मुँह है न आँत।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海底のクジラの骨に穴を開けて食べる。口も腸もない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입도 장도 없이, 해저의 고래 뼈를 파고들어 먹는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钻入海底的鲸骨并以之为食——它没有口也没有肠胃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鑽進海底的鯨骨並啃食——牠沒有嘴也沒有腸。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحفر في عظام الحيتان على القاع وتأكلها، وهي بلا فم أو أمعاء."
          }
        }
      }
    },
    "creature.giantsquid.name": {
