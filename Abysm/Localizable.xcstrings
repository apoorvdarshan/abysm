    "creature.combjelly.fact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beats rows of tiny hairs that scatter light into shimmering rainbows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate hileras de cilios diminutos que dispersan la luz en irisaciones relucientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il agite des rangées de cils qui dispersent la lumière en arcs-en-ciel chatoyants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt Reihen winziger Härchen, die Licht in schimmernde Regenbögen brechen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muove file di minuscole ciglia che diffondono la luce in scintillanti arcobaleni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate fileiras de minúsculos pelos que dispersam a luz em arco-íris cintilantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бьёт рядами крошечных ресничек, что рассеивают свет в мерцающую радугу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porusza rzędami maleńkich rzęsek, które rozszczepiają światło w mieniące się tęcze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat met rijen kleine haartjes die het licht in glinsterende regenbogen verstrooien."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığı parıldayan gökkuşaklarına dağıtan sıra sıra minik tüylerini çırpar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नन्हे रोमों की कतारें हिलाकर रोशनी को झिलमिलाते इंद्रधनुषों में बिखेरती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな毛の列を打ち、光を散らしてきらめく虹色を生む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 털 줄을 움직여 빛을 흩뿌리며 영롱한 무지개를 낸다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摆动成排的微小纤毛，将光线散射成闪烁的彩虹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擺動成排的細毛，將光線散射成閃爍的彩虹。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرّك صفوفًا من شُعيرات دقيقة تبعثر الضوء إلى أقواس قزح متلألئة."
          }
        }
      }
    },
