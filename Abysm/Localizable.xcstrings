        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラスのように透明なイカで、赤みを帯びた色に染まることもある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리처럼 투명한 오징어로, 붉은 색소로 몸을 물들일 수 있다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通体晶莹透明的乌贼，能瞬间泛起红色的色素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "晶瑩透明的魷魚，能泛起紅色的色素。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حبّار زجاجي شفّاف يستطيع أن يتورّد بصبغة حمراء."
