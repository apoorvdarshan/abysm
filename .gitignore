# macOS
.DS_Store

# Xcode — user-specific & build artifacts
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Agent skills (materialized; restore with `npx skills` from skills-lock.json)
.agents/
.claude/skills/

# Swift Package Manager
.swiftpm/
.build/

# Vercel (local link, pulled settings, and env tokens — never commit)
.vercel/
.env*

# Cloudflare Wrangler local state
.wrangler/
web/dist/

# Node.js tooling for the website build
node_modules/

# CocoaPods / Carthage (unused now, future-proofing)
Pods/
Carthage/Build/

# Python bytecode (CI tests under scripts/ci/, fuzz targets under fuzz/)
__pycache__/
*.pyc

# The store-release checkout the fuzz targets test (fuzz/README.md)
/.store-release/
